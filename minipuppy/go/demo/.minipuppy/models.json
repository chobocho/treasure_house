{
  "고치기-대본": {
    "type": "scripted",
    "replies": [
      {"tool": "list_files", "args": {"pattern": "*.go"}},
      {"tool": "read_file",  "args": {"path": "calc.go"}},
      {"tool": "edit_file",  "args": {"path": "calc.go",
                                      "find": "return a - b",
                                      "replace": "return a + b"}},
      {"tool": "run_command", "args": {"command": "go test ./..."}},
      {"text": "Add 가 뺄셈을 하고 있었다. a + b 로 고쳤고 go test 로 확인했다."}
    ]
  },
  "허용목록-시험": {
    "type": "scripted",
    "replies": [
      {"tool": "edit_file", "args": {"path": "calc.go", "find": "Mul",
                                     "replace": "곱하기"}},
      {"text": "이 에이전트로는 파일을 못 고친다."}
    ]
  }
