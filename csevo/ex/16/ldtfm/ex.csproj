<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <!-- 안쪽 평가(NoLv=1)는 LangVersion 을 비워 SDK 기본값을 본다 -->
  <PropertyGroup Condition="'$(NoLv)' != '1'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <T Include="net48;netstandard2.0;netstandard2.1;netcoreapp3.1" />
    <T Include="net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;net11.0" />
  </ItemGroup>
  <Target Name="Ladder">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Show"
      Properties="TargetFramework=%(T.Identity);NoLv=1" />
  </Target>
  <Target Name="Show">
    <PropertyGroup>
      <Tfm>$(TargetFramework) $(TargetFrameworkIdentifier)</Tfm>
    </PropertyGroup>
    <Message Importance="high" Text="$(Tfm) $(LangVersion)" />
  </Target>
</Project>
