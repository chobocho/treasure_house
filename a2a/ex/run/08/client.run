# 6장 — SDK 클라이언트. 숙소 완성 에이전트(탭 뒤)를 막는 호출과
# 스트림으로, 스트림을 안 하는 견적 에이전트를 스트림으로 부르고,
# 헤더 실험 서버에 우리 fetch·인터셉터를 달아 부르고, 오류 넷을
# 일부러 일으킨다. 10859 에는 아무도 듣지 않는다.
serve name=lodging ready=tcp:10850 cmd="ts:agents/lodging.ts \
      --port 10850 --url http://127.0.0.1:10860/"
serve name=quote ready=tcp:10851 cmd="ts:08/step2_task.ts \
      --port 10851 --url http://127.0.0.1:10861/"
serve name=who ready=tcp:10852 cmd="ts:08/headers.ts --port 10852"
tap   name=lodging-wire listen=10860 target=10850
tap   name=quote-wire listen=10861 target=10851
tap   name=who-wire listen=10862 target=10852
run   cmd="ts:08/client_send.ts http://127.0.0.1:10860/ --no-stream"
run   cmd="ts:08/client_send.ts http://127.0.0.1:10860/"
run   cmd="ts:08/client_send.ts http://127.0.0.1:10861/"
run   cmd="ts:08/client_hooks.ts http://127.0.0.1:10862/"
run   cmd="ts:08/client_errors.ts http://127.0.0.1:10860/ \
      http://127.0.0.1:10859/"
