# 0부 — 세 언어의 설치 상태를 명령으로 확인한다(서버 없음).
# 화면의 python 은 a2a/.venv 의 파이썬이다(a2arun 이 PATH 앞에 둔다).
run   cmd="sh:grep -n a2a-sdk py/requirements.txt"
run   cmd="sh:python --version"
run   cmd="sh:python -m pip freeze | grep -i '^a2a'"
run   cmd="sh:grep -n typescript ts/package.json"
run   cmd="sh:cd ts && npm ls --depth=0"
run   cmd="sh:cd ts && npx tsc --version"
run   cmd="sh:go version"
run   cmd="sh:cd go && go list -m github.com/a2aproject/a2a-go/v2"
