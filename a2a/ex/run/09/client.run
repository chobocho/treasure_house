# 6장 — SDK 클라이언트. 숙소 완성 에이전트(탭 뒤)를 막는 호출과
# 스트림으로, 스트림을 안 하는 견적 에이전트를 스트림으로 부르고,
# 머리글 실험 서버에 우리 http.Client·가로채기를 달아 부르고, 오류
# 넷을 일부러 일으킨다. 10959 에는 아무도 듣지 않는다.
serve name=lodging ready=tcp:10950 cmd="go:agents/lodging \
      --port 10950 --url http://127.0.0.1:10960/"
serve name=quote ready=tcp:10951 cmd="go:09/step2_task \
      --port 10951 --url http://127.0.0.1:10961/"
serve name=who ready=tcp:10952 cmd="go:09/headers --port 10952"
tap   name=lodging-wire listen=10960 target=10950
tap   name=quote-wire listen=10961 target=10951
run   cmd="go:09/client_send -no-stream http://127.0.0.1:10960/"
run   cmd="go:09/client_send http://127.0.0.1:10960/"
run   cmd="go:09/client_send http://127.0.0.1:10961/"
run   cmd="go:09/client_hooks http://127.0.0.1:10952/"
run   cmd="go:09/client_errors http://127.0.0.1:10960/ \
      http://127.0.0.1:10959/"
