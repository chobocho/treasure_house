# 8장 — go test 셋. 처리기 층(완성판, 3단계)과 HTTP 층. 완성판의
# 시험 파일은 09/testdata 에 있고 -overlay 로 agents/lodging 에 놓인다.
# 3단계 시험은 일부러 실패한다(종료 코드 1).
run cmd="go:09/run_tests -into agents/lodging ./agents/lodging \
    -run TestLodging" timeout=400
run cmd="go:09/run_tests ./09/step3_ask" exit=1 timeout=400
run cmd="go:09/run_tests -into agents/lodging ./agents/lodging \
    -run 'TestWire|TestClient'" timeout=400
