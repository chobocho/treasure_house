# 2장 — 숙소 에이전트의 카드는 받히지만, 그 카드가 알리는 주소
# (11559)에는 아무도 없다. 기획 에이전트 셋(py·ts·go)은 발견을
# 마치고 셋에 맡기다가 숙소에서 닿지 못한다.
serve name=lodging ready=tcp:11550 \
      cmd="py:agents/lodging.py --port 11550 \
      --url http://127.0.0.1:11559/"
serve name=catering ready=tcp:11551 \
      cmd="py:agents/catering.py --port 11551"
serve name=bus ready=tcp:11552 \
      cmd="py:agents/bus.py --port 11552 --step-ms 100"
serve name=settlement ready=tcp:11553 \
      cmd="py:agents/settlement.py --port 11553"
serve name=py ready=tcp:11554 \
      cmd="py:12/planner_at.py 11554 11550 11551 11552 11553"
serve name=ts ready=tcp:11555 \
      cmd="ts:15/planner_at.ts 11555 11550 11551 11552 11553"
serve name=go ready=tcp:11556 \
      cmd="go:15/planner_at 11556 11550 11551 11552 11553"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11554/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11555/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11556/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
