# 2장 — 명단(--agents)에 정산 에이전트가 빠진 기획 에이전트 셋.
# 정산 에이전트(11516)는 떠 있지만 명단에 없고, 대신 기획 에이전트
# 자기 주소가 들어 있다(어느 역할에도 맞지 않는 카드). Go 의 stderr
# 는 패닉 스택(고루틴 번호가 매번 다르다)이라 버린다.
serve name=lodging ready=tcp:11510 \
      cmd="py:agents/lodging.py --port 11510"
serve name=catering ready=tcp:11511 \
      cmd="py:agents/catering.py --port 11511"
serve name=bus ready=tcp:11512 \
      cmd="py:agents/bus.py --port 11512 --step-ms 100"
serve name=settlement ready=tcp:11516 \
      cmd="py:agents/settlement.py --port 11516"
serve name=py ready=tcp:11513 \
      cmd="py:12/planner_at.py 11513 11513 11510 11511 11512"
serve name=ts ready=tcp:11514 \
      cmd="ts:15/planner_at.ts 11514 11514 11510 11511 11512"
serve name=go ready=tcp:11515 stderr=drop \
      cmd="go:15/planner_at 11515 11515 11510 11511 11512"
run   cmd="py:15/skills.py 11510 11511 11512 11516 11513"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11513/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'" exit=1
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11514/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11515/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
