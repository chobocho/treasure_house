# 6장 — TypeScript 메시. 다섯 에이전트가 모두 TypeScript, 저마다 앞에
# 탭을 둔다. 나머지는 15/mesh_py.run 과 같다 — ask 의 한 문장과 "승인",
# 그리고 대조기(15/check.py, 파이썬)가 끝난 작업을 골든 숫자와 맞춘다.
serve name=lodging ready=tcp:11580 \
      cmd="ts:agents/lodging.ts --port 11580 \
      --url http://127.0.0.1:11585/"
serve name=catering ready=tcp:11581 \
      cmd="ts:agents/catering.ts --port 11581 \
      --url http://127.0.0.1:11586/"
serve name=bus ready=tcp:11582 \
      cmd="ts:agents/bus.ts --port 11582 --step-ms 100 \
      --url http://127.0.0.1:11587/"
serve name=settlement ready=tcp:11583 \
      cmd="ts:agents/settlement.ts --port 11583 \
      --url http://127.0.0.1:11588/"
tap   name=lodging-wire listen=11585 target=11580
tap   name=catering-wire listen=11586 target=11581
tap   name=bus-wire listen=11587 target=11582
tap   name=settle-wire listen=11588 target=11583
serve name=planner ready=tcp:11584 \
      cmd="ts:15/planner_via.ts 11584 11589 \
      11585 11586 11587 11588"
tap   name=planner-wire listen=11589 target=11584
run   cmd="py:agents/ask.py http://127.0.0.1:11589/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="py:15/check.py http://127.0.0.1:11584/"
