# 7장 — 실패 경로, Go 메시. 파이썬 메시(fail_py.run)와 같은
# 여섯 문장을 같은 차례로 보낸다 — 포트와 언어 머리만 다르다.
serve name=lodging ready=tcp:11590 \
      cmd="go:agents/lodging --port 11590 \
      --url http://127.0.0.1:11595/"
serve name=catering ready=tcp:11591 \
      cmd="go:agents/catering --port 11591"
serve name=bus ready=tcp:11592 \
      cmd="go:agents/bus --port 11592 --step-ms 2000"
serve name=settlement ready=tcp:11593 \
      cmd="go:agents/settlement --port 11593 \
      --url http://127.0.0.1:11598/"
tap   name=lodging-wire listen=11595 target=11590
tap   name=settle-wire listen=11598 target=11593
serve name=planner ready=tcp:11594 \
      cmd="go:15/planner_at 11594 11595 11591 11592 11598"
run   cmd="py:agents/ask.py http://127.0.0.1:11594/ \
      '2026-12-31부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11594/ \
      '2026-10-30부터 1박 2일, 70명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11594/ \
      '2026-10-30부터 1박 2일, 30명(채식 40명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11594/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 4,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11594/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' '안 됩니다'"
run   cmd="py:15/settle_left.py http://127.0.0.1:11593/"
run   cmd="py:15/cancel_bus.py http://127.0.0.1:11594/ \
      http://127.0.0.1:11592/" timeout=60
