# 6장 — 섞인 메시. 기획 Go →
#  숙소 TypeScript · 식사 파이썬 · 교통 Go · 정산 TypeScript.
# 정산 에이전트 앞에만 탭을 둔다(언어가 갈리는 정산 요청을 본다).
# ask 가 기획 에이전트에 바로 말하고, 대조기가 골든 숫자와 맞춘다.
serve name=lodging ready=tcp:11592 \
      cmd="ts:agents/lodging.ts --port 11592"
serve name=catering ready=tcp:11593 \
      cmd="py:agents/catering.py --port 11593"
serve name=bus ready=tcp:11594 \
      cmd="go:agents/bus --port 11594 --step-ms 100"
serve name=settlement ready=tcp:11595 \
      cmd="ts:agents/settlement.ts --port 11595 \
      --url http://127.0.0.1:11597/"
tap   name=settle-wire listen=11597 target=11595
serve name=planner ready=tcp:11596 \
      cmd="go:15/planner_at 11596 11592 11593 11594 11597"
run   cmd="py:agents/ask.py http://127.0.0.1:11596/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="py:15/check.py http://127.0.0.1:11596/"
