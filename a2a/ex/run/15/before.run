# 2장 — 고치기 전의 기획 에이전트 셋(15/planner_old·old_at)으로 1·2장
# 의 결함을 다시 본다. A 셋: 명단에 정산이 없다(자기 주소가 대신
# 있다). B 셋: 명단에 아무도 없는 주소(11569) 하나뿐. Go 의 stderr
# 는 버린다 — A 는 패닉 스택(고루틴 번호가 매번 다르다), B 는 SDK 의
# 기록(작업 id 가 찍혔다 말았다 한다).
serve name=lodging ready=tcp:11560 \
      cmd="py:agents/lodging.py --port 11560"
serve name=catering ready=tcp:11561 \
      cmd="py:agents/catering.py --port 11561"
serve name=bus ready=tcp:11562 \
      cmd="py:agents/bus.py --port 11562 --step-ms 100"
serve name=py-a ready=tcp:11563 \
      cmd="py:15/old_at.py 11563 11563 11560 11561 11562"
serve name=ts-a ready=tcp:11564 \
      cmd="ts:15/old_at.ts 11564 11564 11560 11561 11562"
serve name=go-a ready=tcp:11565 stderr=drop \
      cmd="go:15/old_at 11565 11565 11560 11561 11562"
serve name=py-b ready=tcp:11566 \
      cmd="py:15/planner_old.py --port 11566 \
      --url http://127.0.0.1:11567/ --agents http://127.0.0.1:11569/"
tap   name=py-b-wire listen=11567 target=11566
serve name=ts-b ready=tcp:11557 \
      cmd="ts:15/planner_old.ts --port 11557 \
      --agents http://127.0.0.1:11569/"
serve name=go-b ready=tcp:11558 stderr=drop \
      cmd="go:15/old_at 11558 11569"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11563/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'" exit=1
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11564/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:11565/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11567/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'" exit=1
run   cmd="py:agents/ask.py http://127.0.0.1:11557/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11558/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11567/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
run   cmd="py:agents/ask.py http://127.0.0.1:11557/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
run   cmd="py:agents/ask.py http://127.0.0.1:11558/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
