# 6장 — Go 메시. 다섯 에이전트가 모두 Go 이고, 저마다 앞에 탭을
# 둔다. 나머지는 15/mesh_py.run 과 같다 — ask 의 한 문장과 "승인",
# 그리고 대조기(15/check.py, 파이썬)가 끝난 작업을 골든 숫자와 맞춘다.
serve name=lodging ready=tcp:11590 \
      cmd="go:agents/lodging --port 11590 \
      --url http://127.0.0.1:11595/"
serve name=catering ready=tcp:11591 \
      cmd="go:agents/catering --port 11591 \
      --url http://127.0.0.1:11596/"
serve name=bus ready=tcp:11592 \
      cmd="go:agents/bus --port 11592 --step-ms 100 \
      --url http://127.0.0.1:11597/"
serve name=settlement ready=tcp:11593 \
      cmd="go:agents/settlement --port 11593 \
      --url http://127.0.0.1:11598/"
tap   name=lodging-wire listen=11595 target=11590
tap   name=catering-wire listen=11596 target=11591
tap   name=bus-wire listen=11597 target=11592
tap   name=settle-wire listen=11598 target=11593
serve name=planner ready=tcp:11594 \
      cmd="go:15/planner_via 11594 11599 \
      11595 11596 11597 11598"
tap   name=planner-wire listen=11599 target=11594
run   cmd="py:agents/ask.py http://127.0.0.1:11599/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="py:15/check.py http://127.0.0.1:11594/"
