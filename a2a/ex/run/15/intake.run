# 1장 — 기획 에이전트 셋(py·ts·go)에 모자란 문장으로 말을 건다.
# 탭 너머로 카드를 받고, 빠진 것을 두 번 되묻게 한 뒤 셋째 답으로
# 문장을 채운다. 명단(--agents)의 11509 에는 아무도 없다 — 2장에서
# 그 끝을 본다(파이썬은 ask 가 오류로 끝난다 — exit=1). 마지막 셋은
# 인원 없이 채식 인원만 적은 한 문장.
serve name=py ready=tcp:11500 \
      cmd="py:agents/planner.py --port 11500 \
      --url http://127.0.0.1:11503/ --agents http://127.0.0.1:11509/"
tap   name=py-wire listen=11503 target=11500
serve name=ts ready=tcp:11501 \
      cmd="ts:agents/planner.ts --port 11501 \
      --url http://127.0.0.1:11504/ --agents http://127.0.0.1:11509/"
tap   name=ts-wire listen=11504 target=11501
serve name=go ready=tcp:11502 \
      cmd="go:agents/planner --port 11502 \
      --url http://127.0.0.1:11505/ --agents http://127.0.0.1:11509/"
tap   name=go-wire listen=11505 target=11502
run   cmd="py:agents/ask.py http://127.0.0.1:11503/ \
      '1박 2일, 30명(채식 2명)' 2026-10-30부터 \
      '예산 6,000,000원, 출발 강남역'" exit=1
run   cmd="py:agents/ask.py http://127.0.0.1:11504/ \
      '1박 2일, 30명(채식 2명)' 2026-10-30부터 \
      '예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11505/ \
      '1박 2일, 30명(채식 2명)' 2026-10-30부터 \
      '예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11503/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
run   cmd="py:agents/ask.py http://127.0.0.1:11504/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
run   cmd="py:agents/ask.py http://127.0.0.1:11505/ \
      '2026-10-30 1박, 채식 2명, 예산 6,000,000원'"
