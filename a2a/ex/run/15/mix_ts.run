# 6장 — 섞인 메시. 기획 TypeScript →
#  숙소 파이썬 · 식사 Go · 교통 TypeScript · 정산 파이썬.
# 정산 에이전트 앞에만 탭을 둔다(언어가 갈리는 정산 요청을 본다).
# ask 가 기획 에이전트에 바로 말하고, 대조기가 골든 숫자와 맞춘다.
serve name=lodging ready=tcp:11586 \
      cmd="py:agents/lodging.py --port 11586"
serve name=catering ready=tcp:11587 \
      cmd="go:agents/catering --port 11587"
serve name=bus ready=tcp:11588 \
      cmd="ts:agents/bus.ts --port 11588 --step-ms 100"
serve name=settlement ready=tcp:11589 \
      cmd="py:agents/settlement.py --port 11589 \
      --url http://127.0.0.1:11591/"
tap   name=settle-wire listen=11591 target=11589
serve name=planner ready=tcp:11590 \
      cmd="ts:15/planner_at.ts 11590 11586 11587 11588 11591"
run   cmd="py:agents/ask.py http://127.0.0.1:11590/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="py:15/check.py http://127.0.0.1:11590/"
