# 7장 — 실패 경로, TypeScript 메시. 파이썬 메시(fail_py.run)와 같은
# 여섯 문장을 같은 차례로 보낸다 — 포트와 언어 머리만 다르다.
serve name=lodging ready=tcp:11580 \
      cmd="ts:agents/lodging.ts --port 11580 \
      --url http://127.0.0.1:11585/"
serve name=catering ready=tcp:11581 \
      cmd="ts:agents/catering.ts --port 11581"
serve name=bus ready=tcp:11582 \
      cmd="ts:agents/bus.ts --port 11582 --step-ms 2000"
serve name=settlement ready=tcp:11583 \
      cmd="ts:agents/settlement.ts --port 11583 \
      --url http://127.0.0.1:11588/"
tap   name=lodging-wire listen=11585 target=11580
tap   name=settle-wire listen=11588 target=11583
serve name=planner ready=tcp:11584 \
      cmd="ts:15/planner_at.ts 11584 11585 11581 11582 11588"
run   cmd="py:agents/ask.py http://127.0.0.1:11584/ \
      '2026-12-31부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11584/ \
      '2026-10-30부터 1박 2일, 70명(채식 2명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11584/ \
      '2026-10-30부터 1박 2일, 30명(채식 40명), \
      예산 6,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11584/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 4,000,000원, 출발 강남역'"
run   cmd="py:agents/ask.py http://127.0.0.1:11584/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' '안 됩니다'"
run   cmd="py:15/settle_left.py http://127.0.0.1:11583/"
run   cmd="py:15/cancel_bus.py http://127.0.0.1:11584/ \
      http://127.0.0.1:11582/" timeout=60
