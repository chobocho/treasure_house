# 2장 — 복구 규칙. 세 언어의 파일 저장소 교통 에이전트를 --recover 로
# 띄우고(빈 디렉터리라 처음엔 할 일이 없다), 첫 단계의 작업을 남긴 채
# 죽인다. 다시 뜰 때 그 작업을 FAILED 로 닫는다.
serve name=bus-py ready=tcp:11760 \
      cmd="py:17/bus_store.py --port 11760 --step-ms 1000 --recover"
serve name=bus-ts ready=tcp:11761 \
      cmd="ts:17/bus_store.ts --port 11761 --step-ms 1000 --recover"
serve name=bus-go ready=tcp:11762 \
      cmd="go:17/busstore --port 11762 --step-ms 1000 --recover"
run   cmd="py:17/store_check.py start http://127.0.0.1:11760/"
restart name=bus-py
run   cmd="py:17/store_check.py start http://127.0.0.1:11761/"
restart name=bus-ts
run   cmd="py:17/store_check.py start http://127.0.0.1:11762/"
restart name=bus-go
run   cmd="py:17/store_check.py look http://127.0.0.1:11760/"
run   cmd="py:17/store_check.py look http://127.0.0.1:11761/"
run   cmd="py:17/store_check.py look http://127.0.0.1:11762/"
