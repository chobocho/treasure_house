# 4장 — 배포 점검. 카드의 캐시 머리글·조건부 GET, 150KB 본문(길이를
# 밝힌 것과 chunked).
# 완성 교통 에이전트 셋(그대로)과, 머리글·한도를 단 파이썬·Go 둘
# (max-age 600초, 본문 한도 100,000바이트).
serve name=bus-py ready=tcp:11780 \
      cmd="py:agents/bus.py --port 11780 --step-ms 10"
serve name=ops-py ready=tcp:11781 \
      cmd="py:17/bus_ops.py --port 11781 --step-ms 10 \
      --cache-age 600 --limit 100000"
serve name=bus-ts ready=tcp:11782 \
      cmd="ts:agents/bus.ts --port 11782 --step-ms 10"
serve name=bus-go ready=tcp:11783 \
      cmd="go:agents/bus --port 11783 --step-ms 10"
serve name=ops-go ready=tcp:11784 \
      cmd="go:17/busops --port 11784 --step-ms 10 \
      --cache-age 600 --limit 100000"
run   cmd="py:17/edge_check.py bus-py=http://127.0.0.1:11780/ \
      ops-py=http://127.0.0.1:11781/ bus-ts=http://127.0.0.1:11782/ \
      bus-go=http://127.0.0.1:11783/ ops-go=http://127.0.0.1:11784/"
