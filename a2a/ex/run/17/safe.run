# 1장 — 끊긴 막는 호출을 다시 보내지 않고 이어 받기. 교통 에이전트
# 셋(단계 1초), 클라이언트는 서버와 같은 언어. 맥락 ctx-safe 를
# 클라이언트가 정해 보내고, 끊긴 뒤 ListTasks 로 찾아 구독한다.
serve name=bus-py ready=tcp:11741 \
      cmd="py:agents/bus.py --port 11741 --step-ms 1000"
serve name=bus-ts ready=tcp:11742 \
      cmd="ts:agents/bus.ts --port 11742 --step-ms 1000"
serve name=bus-go ready=tcp:11743 \
      cmd="go:agents/bus --port 11743 --step-ms 1000"
run   cmd="py:17/safe.py http://127.0.0.1:11741/"
run   cmd="ts:17/safe.ts http://127.0.0.1:11742/"
run   cmd="go:17/safe http://127.0.0.1:11743/"
