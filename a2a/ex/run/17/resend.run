# 1장 — 막는 SendMessage 를 1.5초에 끊고, 같은 messageId 로 다시.
# 교통 에이전트 셋(단계 하나 1초, 세 단계 3초), 클라이언트는 서버와
# 같은 언어. 다시 보낸 뒤 ListTasks 로 그 맥락의 작업을 센다.
serve name=bus-py ready=tcp:11701 \
      cmd="py:agents/bus.py --port 11701 --step-ms 1000"
serve name=bus-ts ready=tcp:11702 \
      cmd="ts:agents/bus.ts --port 11702 --step-ms 1000"
serve name=bus-go ready=tcp:11703 \
      cmd="go:agents/bus --port 11703 --step-ms 1000"
run   cmd="py:17/resend.py http://127.0.0.1:11701/"
run   cmd="ts:17/resend.ts http://127.0.0.1:11702/"
run   cmd="go:17/resend http://127.0.0.1:11703/"
