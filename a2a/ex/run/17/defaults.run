# 1장 — SDK 기본 시간 제한. 교통 에이전트 셋(단계 2초, 세 단계 6초)에
# 시간 제한을 주지 않은 막는 SendMessage. 클라이언트는 서버와 같은 언어.
serve name=bus-py ready=tcp:11721 \
      cmd="py:agents/bus.py --port 11721 --step-ms 2000"
serve name=bus-ts ready=tcp:11722 \
      cmd="ts:agents/bus.ts --port 11722 --step-ms 2000"
serve name=bus-go ready=tcp:11723 \
      cmd="go:agents/bus --port 11723 --step-ms 2000"
run   cmd="py:17/defaults.py http://127.0.0.1:11721/"
run   cmd="ts:17/defaults.ts http://127.0.0.1:11722/"
run   cmd="go:17/defaults http://127.0.0.1:11723/"
