# 2장 — 파일 저장소를 쓴 TypeScript 교통 에이전트(단계 1초)를 죽이고
# 다시 띄운다. 대본은 store_py.run 과 같다.
serve name=bus ready=tcp:11751 \
      cmd="ts:17/bus_store.ts --port 11751 --step-ms 1000"
run   cmd="py:17/store_check.py make http://127.0.0.1:11751/"
run   cmd="py:17/store_check.py look http://127.0.0.1:11751/"
run   cmd="py:17/store_check.py start http://127.0.0.1:11751/"
restart name=bus
wait  ms=3000   # 죽지 않았다면 배차가 끝났을 시간
run   cmd="py:17/store_check.py look http://127.0.0.1:11751/"
run   cmd="py:17/store_check.py poke http://127.0.0.1:11751/"
run   cmd="py:17/store_check.py look http://127.0.0.1:11751/"
