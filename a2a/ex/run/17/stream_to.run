# 1장 — 스트림에 1.5초 제한. 교통 에이전트 셋(단계 1초), 클라이언트는
# 서버와 같은 언어. 끊긴 뒤 3초 기다렸다 GetTask 로 작업을 본다.
serve name=bus-py ready=tcp:11711 \
      cmd="py:agents/bus.py --port 11711 --step-ms 1000"
serve name=bus-ts ready=tcp:11712 \
      cmd="ts:agents/bus.ts --port 11712 --step-ms 1000"
serve name=bus-go ready=tcp:11713 \
      cmd="go:agents/bus --port 11713 --step-ms 1000"
run   cmd="py:17/stream_to.py http://127.0.0.1:11711/"
run   cmd="ts:17/stream_to.ts http://127.0.0.1:11712/"
run   cmd="go:17/stream_to http://127.0.0.1:11713/"
