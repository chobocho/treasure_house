# 3장 — SDK 가 스스로 남기는 기록. 파이썬은 logging 을 INFO 로 켜고,
# TS 는 켤 것이 없어 완성 에이전트 그대로, Go 는 SDK 의 로깅
# 가로채기 + slog JSON 을 켰다. 같은 막는 SendMessage 를 하나씩 —
# 파이썬 서버에는 TS 클라이언트가 보낸다(파이썬 클라이언트는 DataPart
# 의 키 차례를 프로세스마다 바꿔 보내서, 본문을 적는 줄이 흔들린다).
serve name=bus-py ready=tcp:11763 \
      cmd="py:17/logged.py --sdk bus --port 11763 --step-ms 100"
serve name=bus-ts ready=tcp:11764 \
      cmd="ts:agents/bus.ts --port 11764 --step-ms 100"
serve name=bus-go ready=tcp:11765 \
      cmd="go:17/busops --sdk --port 11765 --step-ms 100"
run   cmd="ts:17/defaults.ts http://127.0.0.1:11763/"
run   cmd="py:17/defaults.py http://127.0.0.1:11764/"
run   cmd="go:17/defaults http://127.0.0.1:11765/"
