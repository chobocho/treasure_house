# 1장 — 다시 하기. 교통 에이전트 셋(단계 1초)에 ① 없는 작업 GetTask,
# ② 1.5초에 끊기는 SendMessage, ③ 아무도 듣지 않는 11799 에 GetTask.
serve name=bus-py ready=tcp:11731 \
      cmd="py:agents/bus.py --port 11731 --step-ms 1000"
serve name=bus-ts ready=tcp:11732 \
      cmd="ts:agents/bus.ts --port 11732 --step-ms 1000"
serve name=bus-go ready=tcp:11733 \
      cmd="go:agents/bus --port 11733 --step-ms 1000"
run   cmd="py:17/retry.py http://127.0.0.1:11731/ \
           http://127.0.0.1:11799/"
run   cmd="ts:17/retry.ts http://127.0.0.1:11732/ \
           http://127.0.0.1:11799/"
run   cmd="go:17/retry http://127.0.0.1:11733/ \
           http://127.0.0.1:11799/"
wait  ms=2500   # 끊긴 배차 셋이 끝까지 가도록(서버 출력)
