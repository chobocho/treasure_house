# 3장 — 푸시 설정이 거절되는 두 자리. (1) 없는 작업 t-404 에 Create —
# 교통 에이전트 셋. (2) 푸시 기능이 없는 숙소 에이전트 셋에 설정을 단
# SendMessage. 끝에 중계기에 무엇이라도 왔는지 묻는다.
serve name=bus-py ready=tcp:11119 cmd="py:agents/bus.py --port 11119"
serve name=bus-ts ready=tcp:11120 cmd="ts:agents/bus.ts --port 11120"
serve name=bus-go ready=tcp:11121 cmd="go:agents/bus --port 11121"
serve name=lodging-py ready=tcp:11125 \
      cmd="py:agents/lodging.py --port 11125"
serve name=lodging-ts ready=tcp:11126 \
      cmd="ts:agents/lodging.ts --port 11126"
serve name=lodging-go ready=tcp:11127 \
      cmd="go:agents/lodging --port 11127"
serve name=relay ready=tcp:11131 cmd="py:11/relay.py --port 11131"
tap   name=bus-py-wire listen=11122 target=11119
tap   name=bus-ts-wire listen=11123 target=11120
tap   name=bus-go-wire listen=11124 target=11121
tap   name=lodging-py-wire listen=11128 target=11125
tap   name=lodging-ts-wire listen=11129 target=11126
tap   name=lodging-go-wire listen=11130 target=11127
run   cmd="sh:for p in 11122 11123 11124; do \
      curl -s -o /dev/null -H 'Content-Type: application/json' \
      -H 'A2A-Version: 1.0' -d @run/11/rpc/create_unknown.json \
      http://127.0.0.1:$p/; done"
run   cmd="sh:for p in 11128 11129 11130; do \
      curl -s -o /dev/null -H 'Content-Type: application/json' \
      -H 'A2A-Version: 1.0' -d @run/11/rpc/inline_lodging.json \
      http://127.0.0.1:$p/; done"
run   cmd="sh:curl -s http://127.0.0.1:11131/seen; echo"
