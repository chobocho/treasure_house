# 6장 — 모르는 필드가 든 답. 작은 서버가 실험 이름(받은 글)대로
# 정상 답의 한 곳에 모르는 것을 끼우고, 파이썬 SDK 클라이언트가
# 막는 호출과 스트림으로 읽는다. 카드에도 모르는 필드가 있다.
serve name=extra ready=tcp:10751 cmd="py:07/extra_server.py \
      --port 10751 --url http://127.0.0.1:10761/"
tap   name=extra-wire listen=10761 target=10751
run   cmd="py:07/strict.py http://127.0.0.1:10761/"
