# 6장 — SDK 클라이언트. 숙소 완성 에이전트(탭 뒤)를 막는 호출과
# 스트림으로 부르고, 헤더 실험 서버에 인터셉터를 달아 부르고,
# 오류 넷을 일부러 일으킨다. 10759 에는 아무도 듣지 않는다.
serve name=lodging ready=tcp:10750 cmd="py:agents/lodging.py \
      --port 10750 --url http://127.0.0.1:10760/"
serve name=who ready=tcp:10752 cmd="py:07/headers.py --port 10752"
tap   name=lodging-wire listen=10760 target=10750
tap   name=who-wire listen=10762 target=10752
run   cmd="py:07/client_send.py http://127.0.0.1:10760/ --no-stream"
run   cmd="py:07/client_send.py http://127.0.0.1:10760/"
run   cmd="py:07/client_hooks.py http://127.0.0.1:10762/"
run   cmd="py:07/client_errors.py http://127.0.0.1:10760/ \
      http://127.0.0.1:10759/"
