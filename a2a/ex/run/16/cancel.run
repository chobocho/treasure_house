# 1장 — 교통 칸 ③. 교통 에이전트 셋(단계 하나 2초)에 세 언어의
# 취소 대본(16/cancel) — returnImmediately → GetTask 로 WORKING 확인
# → CancelTask → 2.5초 뒤 GetTask. 폴링 때문에 탭은 두지 않는다.
serve name=bus-py ready=tcp:11630 \
      cmd="py:agents/bus.py --port 11630 --step-ms 2000"
serve name=bus-ts ready=tcp:11631 \
      cmd="ts:agents/bus.ts --port 11631 --step-ms 2000"
serve name=bus-go ready=tcp:11632 \
      cmd="go:agents/bus --port 11632 --step-ms 2000"
run   cmd="py:16/cancel.py http://127.0.0.1:11630/"
run   cmd="py:16/cancel.py http://127.0.0.1:11631/"
run   cmd="py:16/cancel.py http://127.0.0.1:11632/"
run   cmd="ts:16/cancel.ts http://127.0.0.1:11630/"
run   cmd="ts:16/cancel.ts http://127.0.0.1:11631/"
run   cmd="ts:16/cancel.ts http://127.0.0.1:11632/"
run   cmd="go:16/cancel http://127.0.0.1:11630/"
run   cmd="go:16/cancel http://127.0.0.1:11631/"
run   cmd="go:16/cancel http://127.0.0.1:11632/"
