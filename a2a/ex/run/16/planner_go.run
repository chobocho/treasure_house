# 1장 — 기획 칸, Go 메시. 동료 넷과 기획 에이전트가 모두
# Go 이고, 기획 앞에만 탭을 둔다. 세 언어의 ask 가 같은
# 한 문장과 "승인" 으로 이야기를 끝까지 돌린다.
serve name=lodging ready=tcp:11680 \
      cmd="go:agents/lodging --port 11680"
serve name=catering ready=tcp:11681 \
      cmd="go:agents/catering --port 11681"
serve name=bus ready=tcp:11682 \
      cmd="go:agents/bus --port 11682 --step-ms 100"
serve name=settlement ready=tcp:11683 \
      cmd="go:agents/settlement --port 11683"
serve name=planner ready=tcp:11684 \
      cmd="go:15/planner_via 11684 11685 \
      11680 11681 11682 11683"
tap   name=planner-wire listen=11685 target=11684
run   cmd="py:agents/ask.py http://127.0.0.1:11685/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11685/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="go:agents/ask http://127.0.0.1:11685/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
