# 1장 — 식사 칸 아홉. 식사 에이전트 셋 앞에 탭을 하나씩 두고, 세
# 언어의 ask 가 스트림(SendStreamingMessage)으로 식단을 맡긴다.
# 상태 갱신 셋, 식단표 조각 셋(append·lastChunk), 파일, 견적.
serve name=catering-py ready=tcp:11610 \
      cmd="py:agents/catering.py --port 11610 \
      --url http://127.0.0.1:11613/"
serve name=catering-ts ready=tcp:11611 \
      cmd="ts:agents/catering.ts --port 11611 \
      --url http://127.0.0.1:11614/"
serve name=catering-go ready=tcp:11612 \
      cmd="go:agents/catering --port 11612 \
      --url http://127.0.0.1:11615/"
tap   name=py-wire listen=11613 target=11610
tap   name=ts-wire listen=11614 target=11611
tap   name=go-wire listen=11615 target=11612
run   cmd="py:agents/ask.py http://127.0.0.1:11613/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="py:agents/ask.py http://127.0.0.1:11614/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="py:agents/ask.py http://127.0.0.1:11615/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11613/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11614/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11615/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="go:agents/ask http://127.0.0.1:11613/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="go:agents/ask http://127.0.0.1:11614/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
run   cmd="go:agents/ask http://127.0.0.1:11615/ \
      --data '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      식단"
