# 4장 — TCK 가 싣고 다니는 스펙 사본과 이 책의 v1.0.1 을 견준다.
# 받은 TCK 의 판, 사본의 출처(version.json), 그리고 두 사본에서 §5.4
# 오류 표의 여섯 줄과 Content-Type 을 정한 줄(§9.1·§11.1).
run   cmd="sh:git -C ../scratch/tck/src log -1 --format='TCK %h %cs'; \
      grep -E 'branch|commitHash' \
      ../scratch/tck/src/specification/version.json"
run   cmd="sh:for f in ../scratch/tck/src/specification \
      ../docs/spec/docs; do echo \"== $f/specification.md\"; \
      grep -E -e '^\| .(TaskNotCancelable|PushNotification)' \
      -e '^\| .(Unsupported|ContentType|InvalidAgent|Version)' \
      $f/specification.md | grep -e '-3200' | tr -s ' '; \
      grep -nE '^- \*\*Content-Type:\*\*' $f/specification.md; done"
