# 4장 — TCK 가 SDK 쪽 실패로 적은 것 셋을 맨손으로 다시 본다.
# 완성 숙소 에이전트 셋에 16/tck_why.py 를 보낸다.
serve name=lodging-py ready=tcp:11688 stderr=drop \
      cmd="py:agents/lodging.py --port 11688"
serve name=lodging-ts ready=tcp:11689 stderr=drop \
      cmd="ts:agents/lodging.ts --port 11689"
serve name=lodging-go ready=tcp:11693 stderr=drop \
      cmd="go:agents/lodging --port 11693"
run   cmd="py:16/tck_why.py py 11688"
run   cmd="py:16/tck_why.py ts 11689"
run   cmd="py:16/tck_why.py go 11693"
