# 1장 — 정산 칸, Go 클라이언트 줄. 정산 에이전트 셋 앞에
# 탭을 두고 12부의 Go 클라이언트 셋을 차례로 — approve(토큰·
# AUTH_REQUIRED·결재), xcard(확장 카드), verify(서명된 카드 —
# 가짜 카드는 impostor 가 낸다).
serve name=settle-py ready=tcp:11654 \
      cmd="py:agents/settlement.py --port 11654 \
      --url http://127.0.0.1:11657/"
serve name=settle-ts ready=tcp:11655 \
      cmd="ts:agents/settlement.ts --port 11655 \
      --url http://127.0.0.1:11658/"
serve name=settle-go ready=tcp:11656 \
      cmd="go:agents/settlement --port 11656 \
      --url http://127.0.0.1:11659/"
serve name=impostor ready=tcp:11660 \
      cmd="py:12/impostor.py --port 11660"
tap   name=py-wire listen=11657 target=11654
tap   name=ts-wire listen=11658 target=11655
tap   name=go-wire listen=11659 target=11656
run   cmd="go:12/approve http://127.0.0.1:11657/"
run   cmd="go:12/approve http://127.0.0.1:11658/"
run   cmd="go:12/approve http://127.0.0.1:11659/"
run   cmd="go:12/xcard http://127.0.0.1:11657/"
run   cmd="go:12/xcard http://127.0.0.1:11658/"
run   cmd="go:12/xcard http://127.0.0.1:11659/"
run   cmd="go:12/verify http://127.0.0.1:11657/ \
      http://127.0.0.1:11660/"
run   cmd="go:12/verify http://127.0.0.1:11658/ \
      http://127.0.0.1:11660/"
run   cmd="go:12/verify http://127.0.0.1:11659/ \
      http://127.0.0.1:11660/"
