# 3장 — 오류 시험대 셋(16/bench): 확장 카드 기능만 켠 카드(-32007),
# 차례를 어기는 실행기(-32006), 고장 나는 실행기(-32603).
serve name=bench-py ready=tcp:11616 stderr=drop \
      cmd="py:16/bench.py --port 11616"
serve name=bench-ts ready=tcp:11617 stderr=drop \
      cmd="ts:16/bench.ts --port 11617"
serve name=bench-go ready=tcp:11618 stderr=drop \
      cmd="go:16/bench --port 11618"
run   cmd="py:16/errs.py py 11616 bench"
run   cmd="py:16/errs.py ts 11617 bench"
run   cmd="py:16/errs.py go 11618 bench"
