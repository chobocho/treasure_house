# 1장 — 정산 칸, TypeScript 클라이언트 줄. 정산 에이전트 셋 앞에
# 탭을 두고 12부의 TypeScript 클라이언트 셋을 차례로 — approve(토큰·
# AUTH_REQUIRED·결재), xcard(확장 카드), verify(서명된 카드 —
# 가짜 카드는 impostor 가 낸다).
serve name=settle-py ready=tcp:11647 \
      cmd="py:agents/settlement.py --port 11647 \
      --url http://127.0.0.1:11650/"
serve name=settle-ts ready=tcp:11648 \
      cmd="ts:agents/settlement.ts --port 11648 \
      --url http://127.0.0.1:11651/"
serve name=settle-go ready=tcp:11649 \
      cmd="go:agents/settlement --port 11649 \
      --url http://127.0.0.1:11652/"
serve name=impostor ready=tcp:11653 \
      cmd="py:12/impostor.py --port 11653"
tap   name=py-wire listen=11650 target=11647
tap   name=ts-wire listen=11651 target=11648
tap   name=go-wire listen=11652 target=11649
run   cmd="ts:12/approve.ts http://127.0.0.1:11650/"
run   cmd="ts:12/approve.ts http://127.0.0.1:11651/"
run   cmd="ts:12/approve.ts http://127.0.0.1:11652/"
run   cmd="ts:12/xcard.ts http://127.0.0.1:11650/"
run   cmd="ts:12/xcard.ts http://127.0.0.1:11651/"
run   cmd="ts:12/xcard.ts http://127.0.0.1:11652/"
run   cmd="ts:12/verify.ts http://127.0.0.1:11650/ \
      http://127.0.0.1:11653/"
run   cmd="ts:12/verify.ts http://127.0.0.1:11651/ \
      http://127.0.0.1:11653/"
run   cmd="ts:12/verify.ts http://127.0.0.1:11652/ \
      http://127.0.0.1:11653/"
