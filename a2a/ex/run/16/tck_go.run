# 4장 — 같은 TCK 를 Go 세 문 숙소 서버에.
serve name=doors-go ready=tcp:11686 stderr=drop \
      cmd="go:13/doors_lodging --port 11686 --grpc-port 11687"
run   cmd="sh:cd ../scratch/tck/src && PYTHONPATH=../../../ex/py/16 \
      ../venv/bin/python run_tck.py --sut-host http://127.0.0.1:11686 \
      -- -p tck_fixed >/dev/null 2>&1; echo TCK 종료 코드 $?" \
      timeout=1500
run   cmd="py:16/tck_sum.py ../../scratch/tck/src/reports"
