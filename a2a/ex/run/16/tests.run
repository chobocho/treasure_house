# 3장 — 정수 자리 손질의 시험. 파이썬·TS 는 고치기 전 판(16/ints_old)
# 에 같은 시험을 먼저 돌려 RED 를 남기고, 그다음 고친 판. Go 의
# common.Int 는 처음부터 약속대로라 고친 판만 있다.
run cmd="py:16/test_ints.py old" exit=1 timeout=60
run cmd="py:16/test_ints.py" timeout=60
run cmd="ts:16/run_tests.ts old" exit=1 timeout=90
run cmd="ts:16/run_tests.ts" timeout=90
run cmd="go:16/run_tests" timeout=400
