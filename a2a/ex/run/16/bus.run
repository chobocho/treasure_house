# 1장 — 교통 칸 ①. 교통 에이전트 셋(단계 하나 0.5초)에 세 언어의
# 5부 클라이언트(modes)가 막는 호출 한 번, returnImmediately 한 번을
# 보내고 GetTask 로 지켜본다. 폴링 횟수가 매번 달라 탭은 두지 않는다.
serve name=bus-py ready=tcp:11620 \
      cmd="py:agents/bus.py --port 11620 --step-ms 500"
serve name=bus-ts ready=tcp:11621 \
      cmd="ts:agents/bus.ts --port 11621 --step-ms 500"
serve name=bus-go ready=tcp:11622 \
      cmd="go:agents/bus --port 11622 --step-ms 500"
run   cmd="py:05/modes.py http://127.0.0.1:11620/"
run   cmd="py:05/modes.py http://127.0.0.1:11621/"
run   cmd="py:05/modes.py http://127.0.0.1:11622/"
run   cmd="ts:05/modes.ts http://127.0.0.1:11620/"
run   cmd="ts:05/modes.ts http://127.0.0.1:11621/"
run   cmd="ts:05/modes.ts http://127.0.0.1:11622/"
run   cmd="go:05/modes http://127.0.0.1:11620/"
run   cmd="go:05/modes http://127.0.0.1:11621/"
run   cmd="go:05/modes http://127.0.0.1:11622/"
