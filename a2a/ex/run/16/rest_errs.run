# 3장 — 같은 오류를 HTTP+JSON 문으로. 13부의 REST 숙소 에이전트
# 셋(13/rest_*)에 맨손 요청(16/rest_errs.py)을 보낸다.
serve name=rest-py ready=tcp:11667 stderr=drop \
      cmd="py:13/rest_agent.py lodging --port 11667"
serve name=rest-ts ready=tcp:11668 stderr=drop \
      cmd="ts:13/rest_agent.ts lodging --port 11668"
serve name=rest-go ready=tcp:11669 stderr=drop \
      cmd="go:13/rest_lodging --port 11669"
run   cmd="py:16/rest_errs.py py 11667"
run   cmd="py:16/rest_errs.py ts 11668"
run   cmd="py:16/rest_errs.py go 11669"
