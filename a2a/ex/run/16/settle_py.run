# 1장 — 정산 칸, 파이썬 클라이언트 줄. 정산 에이전트 셋 앞에
# 탭을 두고 12부의 파이썬 클라이언트 셋을 차례로 — approve(토큰·
# AUTH_REQUIRED·결재), xcard(확장 카드), verify(서명된 카드 —
# 가짜 카드는 impostor 가 낸다).
serve name=settle-py ready=tcp:11640 \
      cmd="py:agents/settlement.py --port 11640 \
      --url http://127.0.0.1:11643/"
serve name=settle-ts ready=tcp:11641 \
      cmd="ts:agents/settlement.ts --port 11641 \
      --url http://127.0.0.1:11644/"
serve name=settle-go ready=tcp:11642 \
      cmd="go:agents/settlement --port 11642 \
      --url http://127.0.0.1:11645/"
serve name=impostor ready=tcp:11646 \
      cmd="py:12/impostor.py --port 11646"
tap   name=py-wire listen=11643 target=11640
tap   name=ts-wire listen=11644 target=11641
tap   name=go-wire listen=11645 target=11642
run   cmd="py:12/approve.py http://127.0.0.1:11643/"
run   cmd="py:12/approve.py http://127.0.0.1:11644/"
run   cmd="py:12/approve.py http://127.0.0.1:11645/"
run   cmd="py:12/xcard.py http://127.0.0.1:11643/"
run   cmd="py:12/xcard.py http://127.0.0.1:11644/"
run   cmd="py:12/xcard.py http://127.0.0.1:11645/"
run   cmd="py:12/verify.py http://127.0.0.1:11643/ \
      http://127.0.0.1:11646/"
run   cmd="py:12/verify.py http://127.0.0.1:11644/ \
      http://127.0.0.1:11646/"
run   cmd="py:12/verify.py http://127.0.0.1:11645/ \
      http://127.0.0.1:11646/"
