# 3장 — 앞 부의 서버를 빌린다: 입력 모드를 검사하는 4부의 접수
# 에이전트(-32005)와, 예산 확장을 required 로 단 14부의 숙소
# 에이전트(-32008). 머리글도 메타데이터도 없이 보낸다.
serve name=intake-py ready=tcp:11633 stderr=drop \
      cmd="py:04/intake.py --port 11633"
serve name=intake-ts ready=tcp:11634 stderr=drop \
      cmd="ts:04/intake.ts --port 11634"
serve name=intake-go ready=tcp:11635 stderr=drop \
      cmd="go:04/intake --port 11635"
serve name=budget-py ready=tcp:11636 stderr=drop \
      cmd="py:14/budget_agent.py --port 11636 --required"
serve name=budget-ts ready=tcp:11637 stderr=drop \
      cmd="ts:14/budget_agent.ts --port 11637 --required"
serve name=budget-go ready=tcp:11638 stderr=drop \
      cmd="go:14/budget_lodging --port 11638 --required"
run   cmd="py:16/errs.py py 11633 ctype"
run   cmd="py:16/errs.py ts 11634 ctype"
run   cmd="py:16/errs.py go 11635 ctype"
run   cmd="py:16/errs.py py 11636 ext"
run   cmd="py:16/errs.py ts 11637 ext"
run   cmd="py:16/errs.py go 11638 ext"
