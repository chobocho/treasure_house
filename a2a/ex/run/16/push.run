# 1장 — 교통 칸 ②. 교통 에이전트 셋(단계 하나 2초) 앞에 탭을 두고,
# 세 언어의 11부 클라이언트(setup)가 푸시 설정을 둘 단다 — 보내는
# 요청에 하나, CreateTaskPushNotificationConfig 로 하나. 웹훅은 중계기.
serve name=bus-py ready=tcp:11623 \
      cmd="py:agents/bus.py --port 11623 --step-ms 2000 \
      --url http://127.0.0.1:11626/"
serve name=bus-ts ready=tcp:11624 \
      cmd="ts:agents/bus.ts --port 11624 --step-ms 2000 \
      --url http://127.0.0.1:11627/"
serve name=bus-go ready=tcp:11625 \
      cmd="go:agents/bus --port 11625 --step-ms 2000 \
      --url http://127.0.0.1:11628/"
serve name=relay ready=tcp:11629 cmd="py:11/relay.py --port 11629"
tap   name=py-wire listen=11626 target=11623
tap   name=ts-wire listen=11627 target=11624
tap   name=go-wire listen=11628 target=11625
run   cmd="py:11/setup.py http://127.0.0.1:11626/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="py:11/setup.py http://127.0.0.1:11627/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="py:11/setup.py http://127.0.0.1:11628/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="ts:11/setup.ts http://127.0.0.1:11626/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="ts:11/setup.ts http://127.0.0.1:11627/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="ts:11/setup.ts http://127.0.0.1:11628/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="go:11/setup http://127.0.0.1:11626/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="go:11/setup http://127.0.0.1:11627/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
run   cmd="go:11/setup http://127.0.0.1:11628/ \
      http://127.0.0.1:11629/ http://127.0.0.1:11629/"
