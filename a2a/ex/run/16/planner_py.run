# 1장 — 기획 칸, 파이썬 메시. 동료 넷과 기획 에이전트가 모두
# 파이썬 이고, 기획 앞에만 탭을 둔다. 세 언어의 ask 가 같은
# 한 문장과 "승인" 으로 이야기를 끝까지 돌린다.
serve name=lodging ready=tcp:11661 \
      cmd="py:agents/lodging.py --port 11661"
serve name=catering ready=tcp:11662 \
      cmd="py:agents/catering.py --port 11662"
serve name=bus ready=tcp:11663 \
      cmd="py:agents/bus.py --port 11663 --step-ms 100"
serve name=settlement ready=tcp:11664 \
      cmd="py:agents/settlement.py --port 11664"
serve name=planner ready=tcp:11665 \
      cmd="py:15/planner_via.py 11665 11666 \
      11661 11662 11663 11664"
tap   name=planner-wire listen=11666 target=11665
run   cmd="py:agents/ask.py http://127.0.0.1:11666/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11666/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="go:agents/ask http://127.0.0.1:11666/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
