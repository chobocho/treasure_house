# 1장 — 기획 칸, TypeScript 메시. 동료 넷과 기획 에이전트가 모두
# TypeScript 이고, 기획 앞에만 탭을 둔다. 세 언어의 ask 가 같은
# 한 문장과 "승인" 으로 이야기를 끝까지 돌린다.
serve name=lodging ready=tcp:11670 \
      cmd="ts:agents/lodging.ts --port 11670"
serve name=catering ready=tcp:11671 \
      cmd="ts:agents/catering.ts --port 11671"
serve name=bus ready=tcp:11672 \
      cmd="ts:agents/bus.ts --port 11672 --step-ms 100"
serve name=settlement ready=tcp:11673 \
      cmd="ts:agents/settlement.ts --port 11673"
serve name=planner ready=tcp:11674 \
      cmd="ts:15/planner_via.ts 11674 11675 \
      11670 11671 11672 11673"
tap   name=planner-wire listen=11675 target=11674
run   cmd="py:agents/ask.py http://127.0.0.1:11675/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="ts:agents/ask.ts http://127.0.0.1:11675/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
run   cmd="go:agents/ask http://127.0.0.1:11675/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
