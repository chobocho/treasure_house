# 5장 — 세 SDK 클라이언트(fold --cut)가 첫 조각 뒤에 스트림을 끊고
# SubscribeToTask 로 다시 붙어 이어 접는다. 식사 에이전트는 끼니
# 사이 3초 — 다시 붙는 요청이 다음 이벤트보다 먼저 닿게 하는 여유다.
serve name=catering-py ready=tcp:11062 \
      cmd="py:agents/catering.py --port 11062 --step-ms 3000"
serve name=catering-ts ready=tcp:11063 \
      cmd="ts:agents/catering.ts --port 11063 --step-ms 3000"
serve name=catering-go ready=tcp:11064 \
      cmd="go:agents/catering --port 11064 --step-ms 3000"
run   cmd="py:10/fold.py --cut http://127.0.0.1:11063/"
run   cmd="ts:10/fold.ts --cut http://127.0.0.1:11064/"
run   cmd="go:10/fold -cut http://127.0.0.1:11062/"
