# 5장 — 종료 실험 에이전트 셋(SDK 기본값)에 INPUT_REQUIRED·
# AUTH_REQUIRED·WORKING 을 청하고, 실행기가 돌아간 그 작업에
# SubscribeToTask 로 다시 붙는다(paused.py).
serve name=closer-py ready=tcp:11065 \
      cmd="py:10/closer.py --port 11065" stderr=drop
serve name=closer-ts ready=tcp:11066 \
      cmd="ts:10/closer.ts --port 11066"
serve name=closer-go ready=tcp:11067 \
      cmd="go:10/closer --port 11067"
run   cmd="py:10/paused.py http://127.0.0.1:11065/"
run   cmd="py:10/paused.py http://127.0.0.1:11066/"
run   cmd="py:10/paused.py http://127.0.0.1:11067/"
