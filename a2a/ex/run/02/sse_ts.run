# TypeScript SSE 서버 앞에 탭. curl -N 으로 날것을, 이어서 클라이언트로.
serve name=sse ready=tcp:10258 \
      cmd="ts:02/sse_server.ts --port 10258"
tap   name=sse-wire listen=10208 target=10258
run   cmd="sh:curl -sN \
      --json '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      http://127.0.0.1:10208/meals"
run   cmd="ts:02/sse_client.ts --url http://127.0.0.1:10208/meals"
