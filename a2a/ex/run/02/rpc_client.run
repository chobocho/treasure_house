# 파이썬 JSON-RPC 서버 하나에 세 언어의 클라이언트가 차례로 묻는다.
serve name=rpc ready=tcp:10256 \
      cmd="py:02/rpc_server.py --port 10256"
tap   name=rpc-wire listen=10206 target=10256
run   cmd="py:02/rpc_client.py --url http://127.0.0.1:10206/"
run   cmd="ts:02/rpc_client.ts --url http://127.0.0.1:10206/"
run   cmd="go:02/rpc_client --url http://127.0.0.1:10206/"
