# Go SSE 서버 앞에 탭. curl -N 으로 날것을, 이어서 클라이언트로.
serve name=sse ready=tcp:10259 \
      cmd="go:02/sse_server --port 10259"
tap   name=sse-wire listen=10209 target=10259
run   cmd="sh:curl -sN \
      --json '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      http://127.0.0.1:10209/meals"
run   cmd="go:02/sse_client --url http://127.0.0.1:10209/meals"
