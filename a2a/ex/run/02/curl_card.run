# 카드 서버와 그 앞의 와이어 탭. curl 은 탭(10201)에 묻는다.
# 서버는 바깥에서 닿는 주소(탭)를 --url 로 받아 카드에 적는다.
serve name=card ready=tcp:10251 \
      cmd="py:02/card_server.py --port 10251 \
           --url http://127.0.0.1:10201/"
tap   name=card-wire listen=10201 target=10251
run   cmd="sh:curl -s \
           http://127.0.0.1:10201/.well-known/agent-card.json"
