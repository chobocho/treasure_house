# 파이썬 SSE 서버 앞에 탭. curl -N 으로 날것을, 이어서 클라이언트로.
serve name=sse ready=tcp:10257 \
      cmd="py:02/sse_server.py --port 10257"
tap   name=sse-wire listen=10207 target=10257
run   cmd="sh:curl -sN \
      --json '{\"nights\":1,\"headcount\":30,\"vegetarians\":2}' \
      http://127.0.0.1:10207/meals"
run   cmd="py:02/sse_client.py --url http://127.0.0.1:10207/meals"
