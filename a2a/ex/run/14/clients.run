# 2장 — 세 SDK 클라이언트(14/budget_client)가 예산 확장을 켜고 세
# 서버(14/budget_*)에 차례로 묻는다. 3×3, 탭은 서버마다 하나.
serve name=py ready=tcp:11441 \
      cmd="py:14/budget_agent.py --port 11441 \
      --url http://127.0.0.1:11451/"
tap   name=py-wire listen=11451 target=11441
serve name=ts ready=tcp:11442 \
      cmd="ts:14/budget_agent.ts --port 11442 \
      --url http://127.0.0.1:11452/"
tap   name=ts-wire listen=11452 target=11442
serve name=go ready=tcp:11443 \
      cmd="go:14/budget_lodging --port 11443 \
      --url http://127.0.0.1:11453/"
tap   name=go-wire listen=11453 target=11443
run   cmd="py:14/budget_client.py http://127.0.0.1:11451/"
run   cmd="py:14/budget_client.py http://127.0.0.1:11452/"
run   cmd="py:14/budget_client.py http://127.0.0.1:11453/"
run   cmd="ts:14/budget_client.ts http://127.0.0.1:11451/"
run   cmd="ts:14/budget_client.ts http://127.0.0.1:11452/"
run   cmd="ts:14/budget_client.ts http://127.0.0.1:11453/"
run   cmd="go:14/budget_client http://127.0.0.1:11451/"
run   cmd="go:14/budget_client http://127.0.0.1:11452/"
run   cmd="go:14/budget_client http://127.0.0.1:11453/"
