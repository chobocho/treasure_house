# 파이썬 SDK 에서 이어 말하기에도 Task 를 다시 실으면? 같은 접수
# 에이전트를 두 판(싣지 않음 / --always 1)으로 띄워 두 마디씩 한다.
serve name=intake ready=tcp:10546 \
      cmd="py:05/reenqueue.py --port 10546"
serve name=intake-always ready=tcp:10547 \
      cmd="py:05/reenqueue.py --port 10547 --always 1"
run   cmd="py:05/twice.py http://127.0.0.1:10546/"
run   cmd="py:05/twice.py http://127.0.0.1:10547/"
