# 카드 넷 — 완성 에이전트와 맨손 셋. 모두 같은 바깥 주소(--url)를
# 적게 해서, 남는 차이는 카드를 만든 코드의 차이뿐이다.
serve name=final ready=tcp:10620 cmd="py:agents/lodging.py \
      --port 10620 --url http://lodging.example/"
serve name=bare-py ready=tcp:10621 cmd="py:06/bare_lodging.py \
      --port 10621 --url http://lodging.example/"
serve name=bare-ts ready=tcp:10622 cmd="ts:06/bare_lodging.ts \
      --port 10622 --url http://lodging.example/"
serve name=bare-go ready=tcp:10623 cmd="go:06/bare_lodging \
      --port 10623 --url http://lodging.example/"
run   cmd="py:06/card_same.py http://127.0.0.1:10620/ \
      http://127.0.0.1:10621/ http://127.0.0.1:10622/ \
      http://127.0.0.1:10623/"
