# 4장 — 맨손 서버 셋에 SendMessage 일곱 번(turns), 앞에 탭을 하나씩.
# 시험 쪽은 urllib 만 쓰는 파이썬 프로그램 하나를 셋에 차례로.
serve name=bare-py ready=tcp:10640 \
      cmd="py:06/bare_lodging.py --port 10640"
serve name=bare-ts ready=tcp:10641 \
      cmd="ts:06/bare_lodging.ts --port 10641"
serve name=bare-go ready=tcp:10642 \
      cmd="go:06/bare_lodging --port 10642"
tap   name=py-wire listen=10643 target=10640
tap   name=ts-wire listen=10644 target=10641
tap   name=go-wire listen=10645 target=10642
run   cmd="py:06/turns.py http://127.0.0.1:10643/"
run   cmd="py:06/turns.py http://127.0.0.1:10644/"
run   cmd="py:06/turns.py http://127.0.0.1:10645/"
