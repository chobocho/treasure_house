# 8장 — 느린 연결 하나를 열어 둔 채 다른 요청을 맨손 서버 셋에.
# 파이썬 서버는 버려진 요청을 뒤늦게 처리하다 stderr 에 흔적을
# 남기는데(접속 포트가 실행마다 달라진다), 이 장의 주제가 아니라 버린다.
serve name=bare-py ready=tcp:10696 stderr=drop \
      cmd="py:06/bare_lodging.py --port 10696"
serve name=bare-ts ready=tcp:10697 \
      cmd="ts:06/bare_lodging.ts --port 10697"
serve name=bare-go ready=tcp:10698 \
      cmd="go:06/bare_lodging --port 10698"
run   cmd="py:06/stall.py 10696"
run   cmd="py:06/stall.py 10697"
run   cmd="py:06/stall.py 10698"
