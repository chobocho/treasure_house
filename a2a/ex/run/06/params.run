# 8장 — ProtoJSON 이 허락하는 다른 꼴(historyLength "2", id 5)을
# 맨손 서버 셋과 완성 에이전트(SDK) 셋에. 시험 쪽은 urllib 만 쓴다.
serve name=bare-py ready=tcp:10690 \
      cmd="py:06/bare_lodging.py --port 10690"
serve name=bare-ts ready=tcp:10691 \
      cmd="ts:06/bare_lodging.ts --port 10691"
serve name=bare-go ready=tcp:10692 \
      cmd="go:06/bare_lodging --port 10692"
serve name=sdk-py ready=tcp:10693 stderr=drop \
      cmd="py:agents/lodging.py --port 10693"
serve name=sdk-ts ready=tcp:10694 \
      cmd="ts:agents/lodging.ts --port 10694"
serve name=sdk-go ready=tcp:10695 \
      cmd="go:agents/lodging --port 10695"
run   cmd="py:06/params_probe.py http://127.0.0.1:10690/"
run   cmd="py:06/params_probe.py http://127.0.0.1:10691/"
run   cmd="py:06/params_probe.py http://127.0.0.1:10692/"
run   cmd="py:06/params_probe.py http://127.0.0.1:10693/"
run   cmd="py:06/params_probe.py http://127.0.0.1:10694/"
run   cmd="py:06/params_probe.py http://127.0.0.1:10695/"
