# 4장 — 맨손 서버 셋에 GetTask 일곱 번·CancelTask 다섯 번, 앞에 탭을 하나씩.
# 시험 쪽은 urllib 만 쓰는 파이썬 프로그램 하나를 셋에 차례로.
serve name=bare-py ready=tcp:10646 \
      cmd="py:06/bare_lodging.py --port 10646"
serve name=bare-ts ready=tcp:10647 \
      cmd="ts:06/bare_lodging.ts --port 10647"
serve name=bare-go ready=tcp:10648 \
      cmd="go:06/bare_lodging --port 10648"
tap   name=py-wire listen=10649 target=10646
tap   name=ts-wire listen=10650 target=10647
tap   name=go-wire listen=10651 target=10648
run   cmd="py:06/get_cancel.py http://127.0.0.1:10649/"
run   cmd="py:06/get_cancel.py http://127.0.0.1:10650/"
run   cmd="py:06/get_cancel.py http://127.0.0.1:10651/"
