# 5장 — 같은 스트림 요청을 탭 없이 소켓으로. 세 서버가 SSE 본문을
# HTTP 로 어떻게 싸 보내는지(판·길이·청크)를 날 바이트로 본다.
serve name=bare-py ready=tcp:10658 \
      cmd="py:06/bare_lodging.py --port 10658"
serve name=bare-ts ready=tcp:10659 \
      cmd="ts:06/bare_lodging.ts --port 10659"
serve name=bare-go ready=tcp:10660 \
      cmd="go:06/bare_lodging --port 10660"
run   cmd="py:06/frames.py 10658"
run   cmd="py:06/frames.py 10659"
run   cmd="py:06/frames.py 10660"
