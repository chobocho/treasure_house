# 5장 — 맨손 서버 셋에 SendStreamingMessage 네 번, 앞에 탭을 하나씩.
# 시험 쪽(stream_turns)은 urllib 으로 SSE 를 손으로 읽는다.
serve name=bare-py ready=tcp:10652 \
      cmd="py:06/bare_lodging.py --port 10652"
serve name=bare-ts ready=tcp:10653 \
      cmd="ts:06/bare_lodging.ts --port 10653"
serve name=bare-go ready=tcp:10654 \
      cmd="go:06/bare_lodging --port 10654"
tap   name=py-wire listen=10655 target=10652
tap   name=ts-wire listen=10656 target=10653
tap   name=go-wire listen=10657 target=10654
run   cmd="py:06/stream_turns.py http://127.0.0.1:10655/"
run   cmd="py:06/stream_turns.py http://127.0.0.1:10656/"
run   cmd="py:06/stream_turns.py http://127.0.0.1:10657/"
