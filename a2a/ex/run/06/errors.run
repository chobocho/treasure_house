# 틀린 요청 열 가지를 맨손 서버 셋에 — 파이썬 서버 앞에는 탭을 두어
# 오류 응답의 바이트를 본다. 시험 쪽(rpc_probe)은 urllib 만 쓴다.
serve name=bare-py ready=tcp:10610 \
      cmd="py:06/bare_lodging.py --port 10610"
serve name=bare-ts ready=tcp:10611 \
      cmd="ts:06/bare_lodging.ts --port 10611"
serve name=bare-go ready=tcp:10612 \
      cmd="go:06/bare_lodging --port 10612"
tap   name=py-wire listen=10613 target=10610
run   cmd="py:06/rpc_probe.py http://127.0.0.1:10613/"
run   cmd="py:06/rpc_probe.py http://127.0.0.1:10611/"
run   cmd="py:06/rpc_probe.py http://127.0.0.1:10612/"
