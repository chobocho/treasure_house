# 6장 — 맨손 클라이언트 셋을 완성 에이전트(SDK) 셋과 맨손 서버 셋에.
# 파이썬 SDK 서버는 카드에 탭의 주소를 적게 해(--url) 탭 너머로 둔다.
serve name=sdk-py ready=tcp:10680 cmd="py:agents/lodging.py \
      --port 10680 --url http://127.0.0.1:10686/"
serve name=sdk-ts ready=tcp:10681 cmd="ts:agents/lodging.ts \
      --port 10681"
serve name=sdk-go ready=tcp:10682 cmd="go:agents/lodging \
      --port 10682"
serve name=bare-py ready=tcp:10683 cmd="py:06/bare_lodging.py \
      --port 10683"
serve name=bare-ts ready=tcp:10684 cmd="ts:06/bare_lodging.ts \
      --port 10684"
serve name=bare-go ready=tcp:10685 cmd="go:06/bare_lodging \
      --port 10685"
tap   name=sdk-py-wire listen=10686 target=10680
run   cmd="py:06/client.py http://127.0.0.1:10686/"
run   cmd="py:06/client.py http://127.0.0.1:10681/"
run   cmd="py:06/client.py http://127.0.0.1:10682/"
run   cmd="py:06/client.py http://127.0.0.1:10683/"
run   cmd="py:06/client.py http://127.0.0.1:10684/"
run   cmd="py:06/client.py http://127.0.0.1:10685/"
run   cmd="ts:06/client.ts http://127.0.0.1:10686/"
run   cmd="ts:06/client.ts http://127.0.0.1:10681/"
run   cmd="ts:06/client.ts http://127.0.0.1:10682/"
run   cmd="ts:06/client.ts http://127.0.0.1:10683/"
run   cmd="ts:06/client.ts http://127.0.0.1:10684/"
run   cmd="ts:06/client.ts http://127.0.0.1:10685/"
run   cmd="go:06/client http://127.0.0.1:10686/"
run   cmd="go:06/client http://127.0.0.1:10681/"
run   cmd="go:06/client http://127.0.0.1:10682/"
run   cmd="go:06/client http://127.0.0.1:10683/"
run   cmd="go:06/client http://127.0.0.1:10684/"
run   cmd="go:06/client http://127.0.0.1:10685/"
