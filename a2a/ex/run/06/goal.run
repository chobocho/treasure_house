# 6부의 목표 — 완성 숙소 에이전트(SDK)와 맨손 숙소 에이전트 셋에
# 같은 대본을. 총무팀 CLI(ask, 파이썬 SDK 클라이언트)가 말을 건다.
serve name=final ready=tcp:10600 \
      cmd="py:agents/lodging.py --port 10600"
serve name=bare-py ready=tcp:10601 \
      cmd="py:06/bare_lodging.py --port 10601"
serve name=bare-ts ready=tcp:10602 \
      cmd="ts:06/bare_lodging.ts --port 10602"
serve name=bare-go ready=tcp:10603 \
      cmd="go:06/bare_lodging --port 10603"
# 스트림으로 두 마디 — 날짜·박 수는 DataPart, 인원은 되물음에 글로
run   cmd="py:agents/ask.py http://127.0.0.1:10600/ \
      --data '{\"date\":\"2026-10-30\",\"nights\":1}' \
      '숙소 부탁합니다' '30명'"
run   cmd="py:agents/ask.py http://127.0.0.1:10601/ \
      --data '{\"date\":\"2026-10-30\",\"nights\":1}' \
      '숙소 부탁합니다' '30명'"
run   cmd="py:agents/ask.py http://127.0.0.1:10602/ \
      --data '{\"date\":\"2026-10-30\",\"nights\":1}' \
      '숙소 부탁합니다' '30명'"
run   cmd="py:agents/ask.py http://127.0.0.1:10603/ \
      --data '{\"date\":\"2026-10-30\",\"nights\":1}' \
      '숙소 부탁합니다' '30명'"
# 막는 호출로 거절 하나 — 12-31 은 세 숙소 모두 문을 닫는다
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:10600/ \
      --data '{\"date\":\"2026-12-31\",\"nights\":1,\"headcount\":30}'"
run   cmd="py:agents/ask.py --no-stream http://127.0.0.1:10601/ \
      --data '{\"date\":\"2026-12-31\",\"nights\":1,\"headcount\":30}'"
