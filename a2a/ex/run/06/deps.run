# 맨손 서버 셋은 무엇을 가져다 쓰나 — 파이썬·TS 는 import 줄을
# 모으고(우리 workshop 모듈 포함), Go 는 표준이 아닌 패키지만 센다.
run cmd="sh:cat py/06/bare_*.py py/workshop/domain.py \
    py/workshop/fixtures.py | grep -E '^(import|from) ' | sort -u"
run cmd="sh:cat ts/06/bare_*.ts ts/workshop/domain.ts \
    ts/workshop/fixtures.ts | grep -E '^import |from \"' | sort -u"
run cmd="sh:cd go && go list -deps \
    -f '{{if not .Standard}}{{.ImportPath}}{{end}}' \
    ./06/bare_lodging | grep ."
