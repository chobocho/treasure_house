# 큰 raw 파트(70,000·80,000바이트)를 파트 확인 에이전트 셋(py·ts·go)
# 에 보낸다. 본문이 커서 탭은 세우지 않는다.
serve name=echo-py ready=tcp:10454 \
      cmd="py:04/parts_agent.py --port 10454"
serve name=echo-ts ready=tcp:10455 \
      cmd="ts:04/parts_agent.ts --port 10455"
serve name=echo-go ready=tcp:10456 \
      cmd="go:04/parts_agent --port 10456"
run   cmd="py:04/big.py http://127.0.0.1:10454/ \
      http://127.0.0.1:10455/ http://127.0.0.1:10456/"
