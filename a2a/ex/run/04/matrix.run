# 3×3 — 세 언어의 클라이언트가 같은 DataPart 를 세 언어의 파트 확인
# 에이전트에 보낸다. 에이전트는 받은 수를 제 언어의 타입으로 말한다.
serve name=echo-py ready=tcp:10440 \
      cmd="py:04/parts_agent.py --port 10440"
serve name=echo-ts ready=tcp:10441 \
      cmd="ts:04/parts_agent.ts --port 10441"
serve name=echo-go ready=tcp:10442 \
      cmd="go:04/parts_agent --port 10442"
run   cmd="py:04/data.py http://127.0.0.1:10440/"
run   cmd="py:04/data.py http://127.0.0.1:10441/"
run   cmd="py:04/data.py http://127.0.0.1:10442/"
run   cmd="ts:04/data.ts http://127.0.0.1:10440/"
run   cmd="ts:04/data.ts http://127.0.0.1:10441/"
run   cmd="ts:04/data.ts http://127.0.0.1:10442/"
run   cmd="go:04/data http://127.0.0.1:10440/"
run   cmd="go:04/data http://127.0.0.1:10441/"
run   cmd="go:04/data http://127.0.0.1:10442/"
