# 카드에 바깥에서 닿지 않는 주소가 적힌 경우. 숙소 에이전트(ts)를
# --url 로 아무도 듣지 않는 포트(10349)를 적어 띄웠다.
serve name=lodging ready=tcp:10321 \
      cmd="ts:agents/lodging.ts --port 10321 \
      --url http://127.0.0.1:10349/"
tap   name=proxy-wire listen=10337 target=10321
run   cmd="py:agents/ask.py http://127.0.0.1:10337/ \
      '2026-10-30 1박 30명'" exit=1
run   cmd="ts:agents/ask.ts http://127.0.0.1:10337/ \
      '2026-10-30 1박 30명'" exit=1
run   cmd="go:agents/ask http://127.0.0.1:10337/ \
      '2026-10-30 1박 30명'" exit=1
