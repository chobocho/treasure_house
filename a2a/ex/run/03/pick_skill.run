# 다섯 에이전트(언어를 섞어 띄운다)의 카드를 태그로 고른다.
# 세 언어의 pick 이 같은 질문 셋에 같은 답을 내는지 본다.
serve name=lodging ready=tcp:10350 \
      cmd="py:agents/lodging.py --port 10350"
serve name=catering ready=tcp:10351 \
      cmd="ts:agents/catering.ts --port 10351"
serve name=bus ready=tcp:10352 \
      cmd="go:agents/bus --port 10352"
serve name=settlement ready=tcp:10353 \
      cmd="py:agents/settlement.py --port 10353"
serve name=planner ready=tcp:10354 \
      cmd="go:agents/planner --port 10354 \
      --agents http://127.0.0.1:10350/"
run   cmd="py:03/pick.py workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="py:03/pick.py lodging \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="py:03/pick.py --out text/markdown workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="ts:03/pick.ts workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="ts:03/pick.ts lodging \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="ts:03/pick.ts --out text/markdown workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="go:03/pick workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="go:03/pick lodging \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
run   cmd="go:03/pick --out text/markdown workshop \
      http://127.0.0.1:10350/ http://127.0.0.1:10351/ \
      http://127.0.0.1:10352/ http://127.0.0.1:10353/ \
      http://127.0.0.1:10354/"
