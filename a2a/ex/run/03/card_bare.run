# 맨손 카드 서버 셋(py·ts·go) 앞에 탭을 하나씩. 카드는 제 경로로
# 한 번, v0.3 이전의 옛 이름(agent.json)으로 한 번 묻는다.
serve name=bare-py ready=tcp:10330 \
      cmd="py:03/card_server.py --port 10330"
serve name=bare-ts ready=tcp:10331 \
      cmd="ts:03/card_server.ts --port 10331"
serve name=bare-go ready=tcp:10332 \
      cmd="go:03/card_server --port 10332"
tap   name=py-wire listen=10303 target=10330
tap   name=ts-wire listen=10304 target=10331
tap   name=go-wire listen=10305 target=10332
run   cmd="sh:for p in 10303 10304 10305; do \
      curl -s -o /dev/null -w '%{http_code}\n' \
      http://127.0.0.1:$p/.well-known/agent-card.json; \
      curl -s http://127.0.0.1:$p/.well-known/agent.json; done"
