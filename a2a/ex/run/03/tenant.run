# 인터페이스에 tenant 를 적은 카드(two_doors --tenant). 세 언어의
# ask 가 요청마다 그 값을 싣는지 탭으로 본다(§8.3.2 의 넷째 규칙).
serve name=doors ready=tcp:10319 \
      cmd="py:03/two_doors.py --port 10319 --tenant bosang-hq \
      --url http://127.0.0.1:10309/"
tap   name=tenant-wire listen=10309 target=10319
run   cmd="py:agents/ask.py http://127.0.0.1:10309/ \
      '2026-10-30 1박'"
run   cmd="ts:agents/ask.ts http://127.0.0.1:10309/ \
      '2026-10-30 1박'"
run   cmd="go:agents/ask http://127.0.0.1:10309/ \
      '2026-10-30 1박'"
