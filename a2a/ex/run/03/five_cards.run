# 파이썬 에이전트 다섯을 띄우고 카드 다섯 장을 요약한다.
serve name=lodging ready=tcp:10310 \
      cmd="py:agents/lodging.py --port 10310"
serve name=catering ready=tcp:10313 \
      cmd="py:agents/catering.py --port 10313"
serve name=bus ready=tcp:10314 \
      cmd="py:agents/bus.py --port 10314"
serve name=settlement ready=tcp:10315 \
      cmd="py:agents/settlement.py --port 10315"
serve name=planner ready=tcp:10316 \
      cmd="py:agents/planner.py --port 10316 \
      --agents http://127.0.0.1:10310/"
run   cmd="py:03/card_summary.py \
      http://127.0.0.1:10310 http://127.0.0.1:10313 \
      http://127.0.0.1:10314 http://127.0.0.1:10315 \
      http://127.0.0.1:10316"
