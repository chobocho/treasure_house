# 숙소 에이전트 셋(py·ts·go) 앞에 탭을 하나씩 세우고 카드를 받는다.
serve name=lodging-py ready=tcp:10310 \
      cmd="py:agents/lodging.py --port 10310"
serve name=lodging-ts ready=tcp:10311 \
      cmd="ts:agents/lodging.ts --port 10311"
serve name=lodging-go ready=tcp:10312 \
      cmd="go:agents/lodging --port 10312"
tap   name=py-wire listen=10300 target=10310
tap   name=ts-wire listen=10301 target=10311
tap   name=go-wire listen=10302 target=10312
run   cmd="sh:curl -s \
      http://127.0.0.1:10300/.well-known/agent-card.json"
run   cmd="sh:curl -s \
      http://127.0.0.1:10301/.well-known/agent-card.json"
run   cmd="sh:curl -s \
      http://127.0.0.1:10302/.well-known/agent-card.json"
