# Go 안내 에이전트를 --no-checks 로 — 카드는 그대로 "아무것도 안
# 켰다" 인데, SDK 에 기능을 넘기지 않았다. 같은 요청 셋을 보낸다.
serve name=caps-go ready=tcp:10366 \
      cmd="go:03/no_caps --port 10366 --no-checks"
tap   name=go-wire listen=10367 target=10366
run   cmd="sh:for m in stream push xcard; do \
      curl -s -o /dev/null -H 'Content-Type: application/json' \
      -H 'A2A-Version: 1.0' -d @run/03/rpc/$m.json \
      http://127.0.0.1:10367/; done"
