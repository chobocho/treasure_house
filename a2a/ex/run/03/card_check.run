# 카드 검증기 셋(py·ts·go)에 같은 카드 여섯 장을 준다: 세 언어의
# 숙소 에이전트(좋은 카드)와 cards/ 의 망가진 카드 셋. 망가진
# 카드는 정적 파일 서버(10380)가 내준다. 오류가 있으니 종료 코드 1.
serve name=lodging-py ready=tcp:10381 \
      cmd="py:agents/lodging.py --port 10381"
serve name=lodging-ts ready=tcp:10382 \
      cmd="ts:agents/lodging.ts --port 10382"
serve name=lodging-go ready=tcp:10383 \
      cmd="go:agents/lodging --port 10383"
serve name=files ready=tcp:10380 \
      cmd="sh:exec python3 -m http.server 10380 \
      --bind 127.0.0.1 --directory run/03/cards 2>/dev/null"
run   cmd="py:03/card_check.py http://127.0.0.1:10381/ \
      http://127.0.0.1:10382/ http://127.0.0.1:10383/ \
      http://127.0.0.1:10380/missing.json \
      http://127.0.0.1:10380/empty.json \
      http://127.0.0.1:10380/url.json" exit=1
run   cmd="ts:03/card_check.ts http://127.0.0.1:10381/ \
      http://127.0.0.1:10382/ http://127.0.0.1:10383/ \
      http://127.0.0.1:10380/missing.json \
      http://127.0.0.1:10380/empty.json \
      http://127.0.0.1:10380/url.json" exit=1
run   cmd="go:03/card_check http://127.0.0.1:10381/ \
      http://127.0.0.1:10382/ http://127.0.0.1:10383/ \
      http://127.0.0.1:10380/missing.json \
      http://127.0.0.1:10380/empty.json \
      http://127.0.0.1:10380/url.json" exit=1
