# 숙소 에이전트 셋(py·ts·go)의 카드 응답 헤더를 보고(날짜만 뺀다),
# 세 언어의 card_cache 로 조건부 GET 을 해 본다. 끝으로 요청 헤더를
# 찍는 echo_etag 서버에 세 card_cache 를 보내, 조건부 GET 에 무엇이
# 덧붙는지 본다.
serve name=lodging-py ready=tcp:10370 \
      cmd="py:agents/lodging.py --port 10370"
serve name=lodging-ts ready=tcp:10371 \
      cmd="ts:agents/lodging.ts --port 10371"
serve name=lodging-go ready=tcp:10372 \
      cmd="go:agents/lodging --port 10372"
serve name=echo ready=tcp:10373 cmd="py:03/echo_etag.py 10373"
run   cmd="sh:for p in 10370 10371 10372; do \
      curl -s -o /dev/null -D - \
      http://127.0.0.1:$p/.well-known/agent-card.json \
      | tr -d '\r' | grep -v -i '^date:'; done"
run   cmd="py:03/card_cache.py http://127.0.0.1:10370/ \
      http://127.0.0.1:10371/ http://127.0.0.1:10372/"
run   cmd="ts:03/card_cache.ts http://127.0.0.1:10370/ \
      http://127.0.0.1:10371/ http://127.0.0.1:10372/"
run   cmd="go:03/card_cache http://127.0.0.1:10370/ \
      http://127.0.0.1:10371/ http://127.0.0.1:10372/"
run   cmd="py:03/card_cache.py http://127.0.0.1:10373/"
run   cmd="ts:03/card_cache.ts http://127.0.0.1:10373/"
run   cmd="go:03/card_cache http://127.0.0.1:10373/"
