# 경로가 붙은 주소(/a2a/)를 주면 세 SDK 는 카드를 어디서 찾나.
# 탭 뒤에는 맨손 카드 서버 — 카드는 /.well-known/ 에만 있다.
serve name=bare ready=tcp:10333 \
      cmd="py:03/card_server.py --port 10333"
tap   name=card-wire listen=10306 target=10333
run   cmd="py:agents/ask.py http://127.0.0.1:10306/a2a/ 안녕" exit=1
run   cmd="ts:agents/ask.ts http://127.0.0.1:10306/a2a/ 안녕" exit=1
run   cmd="go:agents/ask http://127.0.0.1:10306/a2a/ 안녕" exit=1
