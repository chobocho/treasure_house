# 숙소 에이전트에 HTTP+JSON 문을 하나 더 단 판(two_doors --rest).
# 카드의 인터페이스 목록은 [HTTP+JSON, JSONRPC] 차례다.
# 세 언어의 ask 가 어느 문으로 들어오는지 탭으로 본다. 인원을
# 빼고 물어 첫 응답(INPUT_REQUIRED)에서 멈춘다.
serve name=doors ready=tcp:10318 \
      cmd="py:03/two_doors.py --port 10318 --rest \
      --url http://127.0.0.1:10308/"
tap   name=doors-wire listen=10308 target=10318
run   cmd="py:agents/ask.py http://127.0.0.1:10308/ \
      '2026-10-30 1박'"
run   cmd="ts:agents/ask.ts http://127.0.0.1:10308/ \
      '2026-10-30 1박'"
run   cmd="go:agents/ask http://127.0.0.1:10308/ \
      '2026-10-30 1박'"
