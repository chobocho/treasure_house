# --url 없이 띄운 숙소 에이전트(py) 앞에 탭. 클라이언트는 탭에서
# 카드를 받는다 — 그다음 요청은 어디로 가나.
serve name=lodging ready=tcp:10320 \
      cmd="py:agents/lodging.py --port 10320"
tap   name=proxy-wire listen=10336 target=10320
run   cmd="py:agents/ask.py http://127.0.0.1:10336/ \
      '2026-10-30 1박 30명'"
run   cmd="ts:agents/ask.ts http://127.0.0.1:10336/ \
      '2026-10-30 1박 30명'"
run   cmd="go:agents/ask http://127.0.0.1:10336/ \
      '2026-10-30 1박 30명'"
