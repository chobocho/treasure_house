# 세 언어의 SDK 클라이언트가 기능 없는 안내 에이전트(py)에 같은 셋을
# 부른다. 탭은 무엇이 실제로 서버까지 갔는지 본다.
serve name=caps ready=tcp:10368 \
      cmd="py:03/no_caps.py --port 10368 \
      --url http://127.0.0.1:10369/"
tap   name=caps-wire listen=10369 target=10368
run   cmd="py:03/caps_probe.py http://127.0.0.1:10369/"
run   cmd="ts:03/caps_probe.ts http://127.0.0.1:10369/"
run   cmd="go:03/caps_probe http://127.0.0.1:10369/"
