# 7장 — AUTH_REQUIRED 의 사슬(§7.6.2). 파이썬 에이전트 다섯을 띄우고
# ask 가 기획 에이전트에 워크숍을 맡긴 뒤 "승인" 으로 답한다. 정산
# 에이전트 앞에 탭을 두어 기획 에이전트가 받는 토큰을 본다.
serve name=lodging ready=tcp:11290 \
      cmd="py:agents/lodging.py --port 11290"
serve name=catering ready=tcp:11291 \
      cmd="py:agents/catering.py --port 11291"
serve name=bus ready=tcp:11292 \
      cmd="py:agents/bus.py --port 11292 --step-ms 100"
serve name=settlement ready=tcp:11293 \
      cmd="py:agents/settlement.py --port 11293 \
      --url http://127.0.0.1:11295/"
tap   name=settle-wire listen=11295 target=11293
serve name=planner ready=tcp:11294 \
      cmd="py:12/planner_at.py 11294 11290 11291 11292 11295"
run   cmd="py:agents/ask.py http://127.0.0.1:11294/ \
      '2026-10-30부터 1박 2일, 30명(채식 2명), \
      예산 6,000,000원, 출발 강남역' 승인"
