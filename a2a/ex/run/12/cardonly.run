# 4장 — 카드는 요구하고, 서버는 검사하지 않는다. 완성 정산 에이전트의
# 카드·실행기에서 문지기만 뺀 서버(card_only)에 토큰 없이 보낸다.
serve name=card-only ready=tcp:11240 \
      cmd="py:12/card_only.py --port 11240"
tap   name=only-wire listen=11241 target=11240
run   cmd="sh:curl -s -o /dev/null \
      http://127.0.0.1:11241/.well-known/agent-card.json"
run   cmd="sh:curl -s -o /dev/null -H 'Content-Type: application/json' \
      -H 'A2A-Version: 1.0' \
      -d @run/12/rpc/settle_small.json http://127.0.0.1:11241/"
