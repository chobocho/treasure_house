find . -type f | sort
cat data/sums.txt
cargo build -q
./target/debug/calc < data/sums.txt
#@ exit: 1
./target/debug/calc < data/sums.txt 2> /dev/null
#@ exit: 1
./target/debug/calc < data/sums.txt > /dev/null
#@ exit: 1
./target/debug/calc '2 + 3 * 4' '10 / 3'
printf '1 + 1\n\n \t\n2 + 2' | ./target/debug/calc
./target/debug/calc < /dev/null
printf '1 +\n2 + 2\n' | ./target/debug/calc
#@ exit: 1
printf '1 + 1\r\n2 * (3\r\n' | ./target/debug/calc
#@ exit: 1
printf '1 + 1\n\377\n2 + 2\n' | ./target/debug/calc
#@ exit: 2
cargo test -q --lib
