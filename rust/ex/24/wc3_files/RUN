find . -type f | sort
cat data/sky.txt
cat data/todo.txt
cargo build -q
./target/debug/wc data/sky.txt
./target/debug/wc data/todo.txt data/empty.txt
./target/debug/wc data/sky.txt data/none.txt data/todo.txt
#@ exit: 1
./target/debug/wc data/sky.txt data/none.txt data/todo.txt 2> /dev/null
#@ exit: 1
./target/debug/wc data/sky.txt data/none.txt data/todo.txt > /dev/null
#@ exit: 1
printf 'one two\nthree' | ./target/debug/wc
./target/debug/wc < data/sky.txt
cat data/sky.txt data/todo.txt | ./target/debug/wc
./target/debug/wc < data
#@ exit: 1
