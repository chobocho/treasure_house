cargo build -q
./target/debug/grep -c rust data/memo.txt
./target/debug/grep -c rust data/memo.txt data/todo.txt
./target/debug/grep -ci rust data/memo.txt data/todo.txt
./target/debug/grep -vc rust data/memo.txt
./target/debug/grep -nc rust data/memo.txt
printf 'go\nrust\n' | ./target/debug/grep -c rust
./target/debug/grep -c zig data/memo.txt data/todo.txt
#@ exit: 1
./target/debug/grep -c rust data/none.txt data/memo.txt
#@ exit: 2
cargo test -q --lib
