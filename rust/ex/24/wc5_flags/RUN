cargo build -q
./target/debug/wc data/sky.txt data/todo.txt
./target/debug/wc -l data/sky.txt data/todo.txt
./target/debug/wc -m -c data/sky.txt
./target/debug/wc -cm data/sky.txt
./target/debug/wc data/sky.txt -w
printf '가 나\n다' | ./target/debug/wc -lwmc
./target/debug/wc -lx data/sky.txt
#@ exit: 2
./target/debug/wc -lx data/sky.txt 2> /dev/null
#@ exit: 2
