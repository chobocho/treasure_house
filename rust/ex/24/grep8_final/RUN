cat data/memo.txt
cat data/todo.txt
cargo build -q
./target/debug/grep rust data/memo.txt
./target/debug/grep -in rust data/memo.txt data/todo.txt
./target/debug/grep -vn rust data/memo.txt
./target/debug/grep -ci rust data/memo.txt data/todo.txt
printf 'go\nrust\n' | ./target/debug/grep -n rust
./target/debug/grep zig data/memo.txt
#@ exit: 1
./target/debug/grep rust data/none.txt data/todo.txt
#@ exit: 2
./target/debug/grep -x rust data/memo.txt
#@ exit: 2
cat tests/golden/in_rust.txt
cargo test -q --test cli
cargo test -q --test golden
cargo test -q
printf 'Rust\n\nrust' | ./target/debug/grep -vn rust
./target/debug/grep -c RUST data/none.txt data/todo.txt
#@ exit: 2
