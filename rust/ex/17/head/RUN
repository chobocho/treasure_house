cat fruits.txt
rustc --edition 2024 head.rs
./head -n 2 fruits.txt
printf 'a\nb\nc\n' | ./head -n 1
seq 1 30 | ./head | tail -n 1
./head -n 2 none.txt
#@ exit: 1
./head -n two fruits.txt
#@ exit: 2
./head -n
#@ exit: 2
./head fruits.txt extra.txt
#@ exit: 2
rustc --edition 2024 --test -o head_test head.rs
./head_test --test-threads=1
