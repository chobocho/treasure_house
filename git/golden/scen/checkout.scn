# 장면 checkout — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write a text:a1\n
write b text:b1\n
mygit add .
mygit commit -m base
> [main (root-commit) a96cd73] base
mygit tag t0
mygit branch feat
mygit switch feat
! Switched to branch 'feat'
write c text:c1\n
write a text:a2\n
mygit add .
mygit commit -m feat
> [feat 21880f8] feat
mygit switch main
! Switched to branch 'main'
cat a
> a1
mygit status
append b text:local\n
mygit switch feat
> M	b
! Switched to branch 'feat'
mygit status
>  M b
cat b
> b1
> local
mygit switch main
> M	b
! Switched to branch 'main'
write a text:mine\n
mygit switch feat
! error: Your local changes to the following files would be overwritten by checkout:
! 	a
! 
! Aborting
= 1
write a text:a1\n
mygit status
>  M b
write c text:untracked\n
mygit switch feat
! error: The following untracked working tree files would be overwritten by checkout:
! 	c
! 
! Aborting
= 1
rm c
mygit checkout t0
> M	b
! HEAD is now at a96cd73 base
mygit switch main
> M	b
! Switched to branch 'main'
mygit switch -c new
! Switched to a new branch 'new'
mygit switch new
> M	b
! Already on 'new'
mygit switch main
> M	b
! Switched to branch 'main'
mygit branch -d new
> Deleted branch new (was a96cd73).
mygit branch -d feat
! error: the branch 'feat' is not fully merged
= 1
mygit branch -d main
! error: cannot delete branch 'main' used by worktree at '<ROOT>'
= 1
mygit switch feat~1
! fatal: a branch is expected, got commit 'feat~1'
= 128
mygit switch nope
! fatal: invalid reference: nope
= 128
mygit checkout nope
! error: pathspec 'nope' did not match any file(s) known to git
= 1
mygit checkout feat
> M	b
! Switched to branch 'feat'
mygit checkout main
> M	b
! Switched to branch 'main'
mygit reflog
