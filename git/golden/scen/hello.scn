# 장면 hello — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write hello.txt text:hello\n
write run.sh text:#!/bin/sh\necho\x20hi\n
chmod run.sh 755
mkdir src
write src/a.py text:print(1)\n
mygit add .
mygit commit -m first
> [main (root-commit) fd4693d] first
@date 1700000060
append hello.txt text:world\n
mygit add hello.txt
mygit commit -m "second\n\nbody line"
