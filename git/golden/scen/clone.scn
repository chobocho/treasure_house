# 장면 clone — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mkdir src
@cd src
mygit init
> Initialized empty Git repository in <ROOT>/src/.git/
write a text:a\n
mygit add a
mygit commit -m one
> [main (root-commit) 85f02a8] one
mygit branch dev
mygit tag v1
@cd .
mygit clone src dst
! Cloning into 'dst'...
! done.
@cd dst
mygit log --oneline
> 85f02a8 one
mygit branch
> * main
mygit status
cat .git/config
> [core]
> 	repositoryformatversion = 0
> 	filemode = true
> 	bare = false
> 	logallrefupdates = true
> [remote "origin"]
> 	url = <ROOT>/src
> 	fetch = +refs/heads/*:refs/remotes/origin/*
> [branch "main"]
> 	remote = origin
> 	merge = refs/heads/main
cat .git/HEAD
> ref: refs/heads/main
cat .git/refs/remotes/origin/HEAD
> ref: refs/remotes/origin/main
ref origin/main
> 85f02a8b5eb2a0f5394b240b00bc411228ed8542
ref origin/dev
> 85f02a8b5eb2a0f5394b240b00bc411228ed8542
ref v1
> 85f02a8b5eb2a0f5394b240b00bc411228ed8542
mygit reflog
> 85f02a8 HEAD@{0}: clone: from <ROOT>/src
