# 장면 merge-resolve — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write f text:a\nb\nc\n
mygit add f
mygit commit -m base
> [main (root-commit) 9933975] base
mygit branch t
mygit switch t
! Switched to branch 't'
@date 1700000060
write f text:a\nB\nc\n

mygit add .
mygit commit -m theirs
> [t 497b597] theirs
mygit switch main
! Switched to branch 'main'
@date 1700000120
write f text:a\nb2\nc\n
mygit add .
mygit commit -m ours
> [main d3d100a] ours
@date 1700000180
mygit merge t
> Auto-merging f
> CONFLICT (content): Merge conflict in f
> Automatic merge failed; fix conflicts and then commit the result.
= 1
cat f
> a
> <<<<<<< HEAD
> b2
> =======
> B
> >>>>>>> t
> c
stage
> 100644 de980441c3ab03a8c07dda1ad27b8a11f39deb1e 1	f
> 100644 59362d46b7561aabadf32af73adf0ab712221968 2	f
> 100644 7be73ce3c1b1cdaea86e8168dfee8575175953bf 3	f
mygit status
> UU f
mygit log
> commit d3d100a54421b7560036593ee1a17d9e9779dd7d
