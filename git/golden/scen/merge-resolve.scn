> Author: A U Thor <author@example.com>
> Date:   Wed Nov 15 07:13:20 2023 +0900
> 
>     base

cat .git/MERGE_MSG
> Merge branch 't'
> 
> # Conflicts:
> #	f
cat .git/MERGE_HEAD
> 497b59755839cad9f485ba001dbde6eb7b894ca5
write f text:a\nboth\nc\n
mygit add f
mygit status
> M  f
@date 1700000240
mygit commit -m "merge t by hand"
> [main 40889f7] merge t by hand
mygit log --oneline
> 40889f7 merge t by hand
> d3d100a ours
> 497b597 theirs
> 9933975 base
