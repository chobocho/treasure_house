# 장면 merge-other-file — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write f text:a\n
mygit add f
mygit commit -m base
> [main (root-commit) c27e9b3] base
mygit branch t
mygit switch t
! Switched to branch 't'
@date 1700000060
write f text:a\n
write g text:theirs\n
mygit add .
mygit commit -m theirs
> [t 74ed399] theirs
mygit switch main
! Switched to branch 'main'
@date 1700000120
write f text:a\nours\n
mygit add .
mygit commit -m ours
> [main a21c362] ours
@date 1700000180
mygit merge t
> Merge made by mygit (3-way, no renames).
cat f
