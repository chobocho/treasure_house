# 장면 merge-ff — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write f text:a\n
mygit add f
mygit commit -m base
> [main (root-commit) c27e9b3] base
mygit branch t
mygit switch t
! Switched to branch 't'
@date 1700000060
write g text:g\n
mygit add g
mygit commit -m add-g
> [t bfec128] add-g
mygit switch main
! Switched to branch 'main'
mygit merge t
> Updating c27e9b3..bfec128
> Fast-forward
mygit merge t
> Already up to date.
mygit log --oneline
> bfec128 add-g
> c27e9b3 base
mygit reflog
> bfec128 HEAD@{0}: merge t: Fast-forward
> c27e9b3 HEAD@{1}: checkout: moving from t to main
> bfec128 HEAD@{2}: commit: add-g
> c27e9b3 HEAD@{3}: checkout: moving from main to t
> c27e9b3 HEAD@{4}: commit (initial): base
cat .git/ORIG_HEAD
> bfec128fd269211b8e54dbbebd0caa3b4d9d29c8
