# 장면 plumbing — tools/golden_cases.py 의 명령을 진짜 git 2.55.0 으로 돌려 채웠다.
# 손으로 고치지 말 것 (SPEC.md §16.4). 다시 만들기: make golden

mygit init
> Initialized empty Git repository in <ROOT>/.git/
write a.txt text:plumbing\n
mygit hash-object a.txt
> 36defdc190fb7407087fa5c7729117e1feb3a27e
mygit hash-object -w a.txt
> 36defdc190fb7407087fa5c7729117e1feb3a27e
mygit add a.txt
mygit write-tree
> b9b856438c664e4dc2a75c8557e2ed4a70fcced8
mygit commit -m "  lead  \n\nx   \n \n\n\ny\n\n"
> [main (root-commit) b864fb9]   lead
mygit cat-file -p HEAD
> tree b9b856438c664e4dc2a75c8557e2ed4a70fcced8
> author A U Thor <author@example.com> 1700000000 +0900
> committer C O Mitter <committer@example.com> 1700000000 +0900
> 
>   lead
> 
> x
> 
> y
mygit commit-tree HEAD^{tree} -m "  m1  "
> 27b98dc1ad066870015af0a5544a7415d564ba6d
mygit commit-tree HEAD^{tree} -p HEAD -m a -m b
> 67c939cce0aa299e97b5a17a64b397cbdf70c366
ref HEAD
> b864fb9b01a6cfacf21bac9e85f203ed25283e94
ref HEAD^{tree}
> b9b856438c664e4dc2a75c8557e2ed4a70fcced8
