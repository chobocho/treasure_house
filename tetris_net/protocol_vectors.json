        { "pid": 1, "at": 3100, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 1, "m": { "t": "err", "code": "phase" } } ] }
      ]
    },
    {
      "name": "solo",
      "why": "1인용도 같은 경로를 탄다 — 좌석 1석, 죽으면 1등, 즉시 end",
      "cfg": { "max": 1, "target": "random" },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "human", "name": "혼자" } },
