          "out": [ { "to": 0, "m": { "t": "grb", "i": 0, "n": 1, "from": 1, "hole": 2 } } ] }
      ]
    },
    {
      "name": "ko-and-end",
      "why": "등수는 죽는 순간 살아 있던 좌석 수. 막타(by)는 hitTTL 안의 마지막 공격자",
      "cfg": { "max": 3, "target": "random" },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "ai", "name": "A" } },
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 1, "kind": "ai", "name": "B" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 2, "kind": "ai", "name": "C" } },
        { "pid": 1, "at": 0, "m": { "t": "start" } }
      ],
      "steps": [
        { "pid": 1, "at": 1000, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 2, "n": 1, "from": 0, "hole": 1 } } ] },
        { "pid": 2, "at": 2000, "m": { "t": "ko", "i": 2 },
          "out": [ { "to": 0, "m": { "t": "ko", "i": 2, "place": 3, "by": 0 } } ] },
        { "pid": 1, "at": 3000, "m": { "t": "ko", "i": 1 },
          "out": [ { "to": 0, "m": { "t": "ko", "i": 1, "place": 2, "by": -1 } },
