        { "pid": 1, "at": 1300, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 1, "n": 1, "from": 0, "hole": 3 } } ] }
      ]
    },
    {
      "name": "target-ko",
      "why": "st 로 올라온 s[4](높이)가 가장 높은 좌석을 노린다. st 중계는 보낸 PC 를 빼고 간다",
      "cfg": { "max": 3, "target": "ko" },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "human", "name": "A" } },
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 1, "kind": "ai", "name": "B" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 2, "kind": "ai", "name": "C" } },
        { "pid": 1, "at": 0, "m": { "t": "ready", "v": true } },
        { "pid": 1, "at": 0, "m": { "t": "start" } }
      ],
      "steps": [
        { "pid": 2, "at": 1000, "m": { "t": "st", "i": 2, "b": "8AA", "s": [0, 0, 0, 0, 7, 0, 5, 0, 3, 1, 18, -1] },
          "out": [ { "to": 1, "m": { "t": "st", "i": 2, "b": "8AA", "s": [0, 0, 0, 0, 7, 0, 5, 0, 3, 1, 18, -1] } } ] },
        { "pid": 1, "at": 1010, "m": { "t": "st", "i": 1, "b": "8AB", "s": [0, 0, 0, 0, 3, 0, 1, 0, 4, 0, 19, -1] },
          "out": [ { "to": 2, "m": { "t": "st", "i": 1, "b": "8AB", "s": [0, 0, 0, 0, 3, 0, 1, 0, 4, 0, 19, -1] } } ] },
        { "pid": 1, "at": 1100, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 2, "n": 1, "from": 0, "hole": 9 } } ] },
        { "pid": 1, "at": 1200, "m": { "t": "st", "i": 1, "b": "8AC", "s": [0, 0, 0, 0, 9, 0, 2, 0, 4, 0, 19, -1] },
          "out": [ { "to": 2, "m": { "t": "st", "i": 1, "b": "8AC", "s": [0, 0, 0, 0, 9, 0, 2, 0, 4, 0, 19, -1] } } ] },
        { "pid": 1, "at": 1300, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 1, "n": 1, "from": 0, "hole": 1 } } ] }
      ]
    },
    {
      "name": "target-attackers",
      "why": "최근 나를 때린 좌석에 반격. hitTTL(8초)이 지나면 기억이 사라지고 random 으로 떨어진다",
      "cfg": { "max": 3, "target": "attackers", "hitTTL": 8000 },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "ai", "name": "A" } },
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 1, "kind": "ai", "name": "B" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 2, "kind": "ai", "name": "C" } },
        { "pid": 1, "at": 0, "m": { "t": "start" } }
      ],
      "steps": [
        { "pid": 1, "at": 1000, "m": { "t": "atk", "i": 1, "n": 1 },
