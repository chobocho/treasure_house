{
  "v": 3,
  "note": "room 엔진 골든 벡터 — Go·파이썬·JS 세 구현이 모두 이 표를 그대로 재현해야 한다. setup 의 출력은 검사하지 않고, steps 의 out 만 순서까지 정확히 비교한다.",
  "cases": [
    {
      "name": "lobby-seat",
      "why": "좌석 배정·반납·자동 배정과 room 브로드캐스트의 모양",
      "cfg": { "max": 2 },
      "seed": 1,
      "setup": [],
      "steps": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": -1, "kind": "human", "name": "보라" },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": false, "alive": true } ] } } ] },
        { "pid": 1, "at": 1, "m": { "t": "seat", "i": -1, "kind": "ai", "name": "봇", "lv": "hard" },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": false, "alive": true },
            { "i": 1, "pid": 1, "name": "봇", "kind": "ai", "lv": "hard", "ready": false, "alive": true } ] } } ] },
        { "pid": 2, "at": 2, "m": { "t": "seat", "i": -1, "kind": "human", "name": "다온" },
          "out": [ { "to": 2, "m": { "t": "err", "code": "seat" } } ] },
        { "pid": 2, "at": 3, "m": { "t": "seat", "i": 5, "kind": "human", "name": "다온" },
          "out": [ { "to": 2, "m": { "t": "err", "code": "seat" } } ] },
        { "pid": 2, "at": 4, "m": { "t": "unseat", "i": 1 },
          "out": [ { "to": 2, "m": { "t": "err", "code": "own" } } ] },
        { "pid": 1, "at": 5, "m": { "t": "unseat", "i": 1 },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": false, "alive": true } ] } } ] },
        { "pid": 2, "at": 6, "m": { "t": "seat", "i": 1, "kind": "human", "name": "다온" },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": false, "alive": true },
            { "i": 1, "pid": 2, "name": "다온", "kind": "human", "lv": "", "ready": false, "alive": true } ] } } ] },
        { "pid": 2, "at": 7, "m": { "t": "start" },
          "out": [ { "to": 2, "m": { "t": "err", "code": "host" } } ] },
        { "pid": 1, "at": 8, "m": { "t": "start" },
          "out": [ { "to": 1, "m": { "t": "err", "code": "ready" } } ] },
        { "pid": 1, "at": 9, "m": { "t": "ready", "v": true },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": true, "alive": true },
            { "i": 1, "pid": 2, "name": "다온", "kind": "human", "lv": "", "ready": false, "alive": true } ] } } ] },
        { "pid": 2, "at": 10, "m": { "t": "ready", "v": true },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": true, "alive": true },
            { "i": 1, "pid": 2, "name": "다온", "kind": "human", "lv": "", "ready": true, "alive": true } ] } } ] },
        { "pid": 1, "at": 11, "m": { "t": "start" },
          "out": [ { "to": 0, "m": { "t": "start", "seed": 270369, "seats": [
            { "i": 0, "pid": 1, "name": "보라", "kind": "human", "lv": "", "ready": true, "alive": true },
            { "i": 1, "pid": 2, "name": "다온", "kind": "human", "lv": "", "ready": true, "alive": true } ] } } ] },
        { "pid": 1, "at": 12, "m": { "t": "seat", "i": 0, "kind": "human", "name": "보라" },
          "out": [ { "to": 1, "m": { "t": "err", "code": "phase" } } ] }
      ]
    },
    {
      "name": "per-peer-limit",
      "why": "PC 1대 = 최대 2석. 세 번째 요청은 full 로 막힌다",
      "cfg": { "max": 8, "perPeer": 2 },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": -1, "kind": "human", "name": "P1" } },
        { "pid": 1, "at": 1, "m": { "t": "seat", "i": -1, "kind": "human", "name": "P2" } }
      ],
      "steps": [
        { "pid": 1, "at": 2, "m": { "t": "seat", "i": -1, "kind": "ai", "name": "봇" },
          "out": [ { "to": 1, "m": { "t": "err", "code": "full" } } ] },
        { "pid": 2, "at": 3, "m": { "t": "seat", "i": -1, "kind": "ai", "name": "봇", "lv": "max" },
          "out": [ { "to": 0, "m": { "t": "room", "host": 1, "seats": [
            { "i": 0, "pid": 1, "name": "P1", "kind": "human", "lv": "", "ready": false, "alive": true },
            { "i": 1, "pid": 1, "name": "P2", "kind": "human", "lv": "", "ready": false, "alive": true },
            { "i": 2, "pid": 2, "name": "봇", "kind": "ai", "lv": "max", "ready": false, "alive": true } ] } } ] }
      ]
    },
    {
      "name": "target-random",
      "why": "random 모드의 난수 소비 순서 — 타겟 1회, 구멍 1회. 순서가 어긋나면 여기서 갈린다",
      "cfg": { "max": 4, "target": "random" },
      "seed": 7,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "human", "name": "A" } },
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 1, "kind": "ai", "name": "B" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 2, "kind": "human", "name": "C" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 3, "kind": "ai", "name": "D" } },
        { "pid": 1, "at": 0, "m": { "t": "ready", "v": true } },
        { "pid": 2, "at": 0, "m": { "t": "ready", "v": true } },
        { "pid": 1, "at": 0, "m": { "t": "start" } }
      ],
      "steps": [
        { "pid": 1, "at": 1000, "m": { "t": "atk", "i": 0, "n": 2 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 2, "n": 2, "from": 0, "hole": 7 } } ] },
        { "pid": 2, "at": 1100, "m": { "t": "atk", "i": 2, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 0, "n": 1, "from": 2, "hole": 7 } } ] },
        { "pid": 1, "at": 1200, "m": { "t": "atk", "i": 1, "n": 4 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 0, "n": 4, "from": 1, "hole": 2 } } ] },
        { "pid": 1, "at": 1300, "m": { "t": "atk", "i": 0, "n": 0 }, "out": [] },
        { "pid": 2, "at": 1400, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 2, "m": { "t": "err", "code": "own" } } ] }
      ]
    },
    {
      "name": "target-even",
      "why": "받은 가비지가 가장 적은 좌석으로. 동률이면 낮은 번호. 타겟 난수는 쓰지 않는다",
      "cfg": { "max": 3, "target": "even" },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "human", "name": "A" } },
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 1, "kind": "ai", "name": "B" } },
        { "pid": 2, "at": 0, "m": { "t": "seat", "i": 2, "kind": "ai", "name": "C" } },
        { "pid": 1, "at": 0, "m": { "t": "ready", "v": true } },
        { "pid": 1, "at": 0, "m": { "t": "start" } }
      ],
      "steps": [
        { "pid": 1, "at": 1000, "m": { "t": "atk", "i": 0, "n": 1 },
          "out": [ { "to": 0, "m": { "t": "grb", "i": 1, "n": 1, "from": 0, "hole": 9 } } ] },
        { "pid": 1, "at": 1100, "m": { "t": "atk", "i": 0, "n": 2 },
