    {
      "name": "peer-bye",
      "why": "PC 가 끊기면 그 PC 의 좌석이 번호 순으로 전멸한다. end 가 나간 뒤의 ko 는 처리하지 않는다",
      "cfg": { "max": 3, "target": "random" },
      "seed": 1,
      "setup": [
        { "pid": 1, "at": 0, "m": { "t": "seat", "i": 0, "kind": "ai", "name": "A" } },
