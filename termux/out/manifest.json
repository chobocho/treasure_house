  "kind": "snapshot",
  "side": "termux"
 },
 "apt_sources.txt": {
  "cmds": [
   "cat $PREFIX/etc/apt/sources.list",
   "ls $PREFIX/etc/apt/sources.list.d",
   "cat $PREFIX/etc/apt/sources.list.d/*.list",
   "ls $PREFIX/etc/apt/trusted.gpg.d",
   "apt list --installed 2>&1 | head -n 3"
