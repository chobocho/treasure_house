  "kind": "stable",
  "side": "termux"
 },
 "deb_by_hand.txt": {
  "cmds": [
   "sh exp/mkdeb/build.sh scratch/deb",
   "dpkg-deb -f scratch/deb/treasure-hello_1.0_all.deb",
   "dpkg-deb -c scratch/deb/treasure-hello_1.0_all.deb | awk '{print $1, $2, $6}'",
   "dpkg -i scratch/deb/treasure-hello_1.0_all.deb 2>&1",
   "treasure-hello",
   "dpkg -L treasure-hello",
   "dpkg -r treasure-hello 2>&1",
   "command -v treasure-hello; echo \"종료 $?\""
  ],
  "kind": "stable",
  "side": "termux"
 },
 "dot_termux.txt": {
  "cmds": [
