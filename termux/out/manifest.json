{
 "api_mechanism.txt": {
  "cmds": [
   "cat $PREFIX/bin/termux-battery-status",
   "stat -c '%A %s %n' $PREFIX/libexec/termux-api",
   "grep -l libexec/termux-api $PREFIX/bin/termux-* | wc -l"
  ],
  "kind": "stable",
  "side": "termux"
 },
 "api_proot.txt": {
  "cmds": [
   "timeout 15 termux-battery-status; echo \"종료 $?\""
