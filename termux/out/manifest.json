  "side": "termux"
 },
 "dpkg_stats.txt": {
  "cmds": [
   "dpkg -l | grep -c '^ii'",
   "python3 py/pkgstat.py $PREFIX/var/lib/dpkg/status",
   "dpkg -S $PREFIX/bin/termux-* | sort"
  ],
  "kind": "stable",
  "side": "termux"
 },
 "env_proot.txt": {
  "cmds": [
   "env | sort",
   "id | tr ' ' '\\n'",
   "uname -srm",
   "head -n 3 /etc/os-release",
   "x=$(readlink /proc/$$/exe); echo \"$x\"",
   "awk '/^TracerPid/{print $1, ($2>0?\"(0 아님)\":0)}' /proc/self/status"
  ],
  "kind": "stable",
  "side": "proot"
 },
 "env_termux.txt": {
  "cmds": [
   "env | sort",
   "id | tr ' ' '\\n'",
   "uname -srm",
   "x=$(readlink /proc/$$/exe); echo \"$x\"",
   "awk '/^TracerPid/{print $1, ($2>0?\"(0 아님)\":0)}' /proc/self/status",
   "tr -d '\\0' < /proc/self/attr/current; echo"
  ],
  "kind": "stable",
  "side": "termux"
 },
